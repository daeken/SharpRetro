; sse3plus.isa — SSE3 / SSSE3 / SSE4.1 / SSE4.2 rows (census-tail from glibc).
; Gated per-feature in xfusion.isa; grouped in one file because each tier's
; corpus presence is small. Split when any grows.

(featuring sse3
    (instruction MOVSLDUP (dst src) "movsldup $dst, $src" (intrinsic movsldup dst src))
    (encoding MOVSLDUP (Vps Wps) (rep 0x0F 0x12))
    (instruction MOVSHDUP (dst src) "movshdup $dst, $src" (intrinsic movshdup dst src))
    (encoding MOVSHDUP (Vps Wps) (rep 0x0F 0x16))
    ; dst.lo = src.lo, dst.hi = src.lo — the vzip-64-lo shape with src as both halves
    ; (wall #32, OA/SDL SSE3 path; same family as MOVLHPS/MOVHPS wall #30).
    (instruction MOVDDUP (dst src) "movddup $dst, $src" (= dst (vzip src src 64 #f)))
    (encoding MOVDDUP (Vpd Wsd) (repnz 0x0F 0x12))
    (instruction LDDQU (dst src) "lddqu $dst, $src" (intrinsic lddqu dst src))
    (encoding LDDQU (Vdq Mdq) (repnz 0x0F 0xF0))
    ; HADDPS: dst[0]=dst[0]+dst[1], dst[1]=dst[2]+dst[3], dst[2]=src[0]+src[1], dst[3]=src[2]+src[3].
    ; NEON FADDP Vd,Vn,Vm has the SAME pairing (Vn-pairs → lo, Vm-pairs → hi) → 1:1.
    (instruction HADDPS (dst src) "haddps $dst, $src" (= dst (vhadd dst src 32)))
    (encoding HADDPS (Vps Wps) (repnz 0x0F 0x7C))
    (instruction HADDPD (dst src) "haddpd $dst, $src" (= dst (vhadd dst src 64)))
    (encoding HADDPD (Vpd Wpd) (opsize 0x0F 0x7C)))

(featuring ssse3
    (instruction PSHUFB-S (dst src) "pshufb $dst, $src" (= dst (vshufv dst src)))
    (encoding PSHUFB-S (Vdq Wdq) (opsize 0x0F 0x38 0x00))
    (instruction PALIGNR (dst src sel) "palignr $dst, $src, $sel" (intrinsic palignr dst src sel))
    (encoding PALIGNR (Vdq Wdq Ib) (opsize 0x0F 0x3A 0x0F))
    (instruction PABSB (dst src) "pabsb $dst, $src" (= dst (viabs src 8)))
    (encoding PABSB (Vdq Wdq) (opsize 0x0F 0x38 0x1C))
    (instruction PABSW (dst src) "pabsw $dst, $src" (= dst (viabs src 16)))
    (encoding PABSW (Vdq Wdq) (opsize 0x0F 0x38 0x1D))
    (instruction PABSD (dst src) "pabsd $dst, $src" (= dst (viabs src 32)))
    (encoding PABSD (Vdq Wdq) (opsize 0x0F 0x38 0x1E)))

(featuring sse4.1
    (instruction PTEST (a b) "ptest $a, $b" (intrinsic ptest a b))
    (encoding PTEST (Vdq Wdq) (opsize 0x0F 0x38 0x17))
    (instruction PMOVZXBW (dst src) "pmovzxbw $dst, $src" (= dst (vzext src 8 16)))
    (encoding PMOVZXBW (Vdq Wq) (opsize 0x0F 0x38 0x30))
    (instruction PMOVZXWD (dst src) "pmovzxwd $dst, $src" (= dst (vzext src 16 32)))
    (encoding PMOVZXWD (Vdq Wq) (opsize 0x0F 0x38 0x33))
    ; verified at bytes with objdump -M intel before adding:
    ;   66 0F 38 40 C1 = pmulld xmm0,xmm1   ·   66 0F 38 3D C1 = pmaxsd xmm0,xmm1
    (instruction PMULLD (dst src) "pmulld $dst, $src" (= dst (vibin dst src 32 2)))
    (encoding PMULLD (Vdq Wdq) (opsize 0x0F 0x38 0x40))
    (instruction PMAXSD (dst src) "pmaxsd $dst, $src" (= dst (vibin dst src 32 5)))
    (encoding PMAXSD (Vdq Wdq) (opsize 0x0F 0x38 0x3D))
    (instruction PMAXSB (dst src) "pmaxsb $dst, $src" (= dst (vibin dst src 8 5)))
    (encoding PMAXSB (Vdq Wdq) (opsize 0x0F 0x38 0x3C))
    (instruction PMINSD (dst src) "pminsd $dst, $src" (= dst (vibin dst src 32 6)))
    (encoding PMINSD (Vdq Wdq) (opsize 0x0F 0x38 0x39))
    (instruction PMINSB (dst src) "pminsb $dst, $src" (= dst (vibin dst src 8 6)))
    (encoding PMINSB (Vdq Wdq) (opsize 0x0F 0x38 0x38))
    (instruction PMAXUD (dst src) "pmaxud $dst, $src" (= dst (vibin dst src 32 7)))
    (encoding PMAXUD (Vdq Wdq) (opsize 0x0F 0x38 0x3F))
    (instruction PMAXUW (dst src) "pmaxuw $dst, $src" (= dst (vibin dst src 16 7)))
    (encoding PMAXUW (Vdq Wdq) (opsize 0x0F 0x38 0x3E))
    (instruction PMINUD (dst src) "pminud $dst, $src" (= dst (vibin dst src 32 8)))
    (encoding PMINUD (Vdq Wdq) (opsize 0x0F 0x38 0x3B))
    (instruction PMINUW (dst src) "pminuw $dst, $src" (= dst (vibin dst src 16 8)))
    (encoding PMINUW (Vdq Wdq) (opsize 0x0F 0x38 0x3A))
    (instruction PCMPEQQ (dst src) "pcmpeqq $dst, $src" (= dst (vibin dst src 64 3)))
    (encoding PCMPEQQ (Vdq Wdq) (opsize 0x0F 0x38 0x29))
    (instruction PEXTRB (dst src sel) "pextrb $dst, $src, $sel" (= dst (vlane-get src sel 8)))
    (encoding PEXTRB (Ed Vdq Ib) (opsize 0x0F 0x3A 0x14))
    (instruction PEXTRD (dst src sel) "pextrd $dst, $src, $sel" (= dst (vlane-get src sel 32)))
    (encoding PEXTRD (Ed Vdq Ib) (opsize 0x0F 0x3A 0x16))
    (instruction PINSRB (dst src sel) "pinsrb $dst, $src, $sel" (= dst (vlane-set dst src sel 8)))
    (encoding PINSRB (Vdq Ed Ib) (opsize 0x0F 0x3A 0x20))
    (instruction MOVNTDQA (dst src) "movntdqa $dst, $src" (intrinsic movntdqa dst src))
    (encoding MOVNTDQA (Vdq Mdq) (opsize 0x0F 0x38 0x2A))
    ; DPPS/DPPD: masked dot-product. imm[7:4]=src-lane-mask (which multiply),
    ; imm[3:0]=dst-lane-mask (where the sum lands; else 0). CP2077 wall #29
    ; @0x1401177bc: dpps xmm0,xmm4,0x7F = the vec3-normalize idiom (xyz·xyz →
    ; all 4 lanes → sqrtss = |v|). aarch64: fmul + INS-wzr per unmasked +
    ; faddp×2 → sum broadcast + INS-wzr per unmasked-out.
    (instruction DPPS (dst src imm) "dpps $dst, $src, $imm"
        (= dst (vdpp dst src imm 32)))
    (encoding DPPS (Vdq Wdq Ib) (opsize 0x0F 0x3A 0x40))
    (instruction DPPD (dst src imm) "dppd $dst, $src, $imm"
        (= dst (vdpp dst src imm 64)))
    (encoding DPPD (Vdq Wdq Ib) (opsize 0x0F 0x3A 0x41)))

(featuring sse4.2
    (instruction PCMPISTRI (a b pred) "pcmpistri $a, $b, $pred" (intrinsic pcmpistri a b pred))
    (encoding PCMPISTRI (Vdq Wdq Ib) (opsize 0x0F 0x3A 0x63))
    (instruction PCMPISTRM (a b pred) "pcmpistrm $a, $b, $pred" (intrinsic pcmpistrm a b pred))
    (encoding PCMPISTRM (Vdq Wdq Ib) (opsize 0x0F 0x3A 0x62))
    (instruction PCMPESTRI (a b pred) "pcmpestri $a, $b, $pred" (intrinsic pcmpestri a b pred))
    (encoding PCMPESTRI (Vdq Wdq Ib) (opsize 0x0F 0x3A 0x61))
    (instruction CRC32-B (dst src) "crc32 $dst, $src" (intrinsic crc32-b dst src))
    (encoding CRC32-B (Gv Eb) (repnz 0x0F 0x38 0xF0))
    (instruction CRC32-V (dst src) "crc32 $dst, $src" (intrinsic crc32-v dst src))
    (encoding CRC32-V (Gv Ev) (repnz 0x0F 0x38 0xF1)))
