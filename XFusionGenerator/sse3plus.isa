; sse3plus.isa — SSE3 / SSSE3 / SSE4.1 / SSE4.2 rows (census-tail from glibc).
; Gated per-feature in xfusion.isa; grouped in one file because each tier's
; corpus presence is small. Split when any grows.

(featuring sse3
    (instruction MOVSLDUP (dst src) "movsldup $dst, $src" (= dst (vdup src 32 #f)))
    (encoding MOVSLDUP (Vps Wps) (rep 0x0F 0x12))
    (instruction MOVSHDUP (dst src) "movshdup $dst, $src" (= dst (vdup src 32 #t)))
    (encoding MOVSHDUP (Vps Wps) (rep 0x0F 0x16))
    ; dst.lo = src.lo, dst.hi = src.lo — the vzip-64-lo shape with src as both halves
    ; (wall #32, OA/SDL SSE3 path; same family as MOVLHPS/MOVHPS wall #30).
    (instruction MOVDDUP (dst src) "movddup $dst, $src" (= dst (vzip src src 64 #f)))
    (encoding MOVDDUP (Vpd Wsd) (repnz 0x0F 0x12))
    (instruction LDDQU (dst src) "lddqu $dst, $src" (intrinsic lddqu dst src))
    (encoding LDDQU (Vdq Mdq) (repnz 0x0F 0xF0))
    ; HADDPS: dst[0]=dst[0]+dst[1], dst[1]=dst[2]+dst[3], dst[2]=src[0]+src[1], dst[3]=src[2]+src[3].
    ; NEON FADDP Vd,Vn,Vm has the SAME pairing (Vn-pairs → lo, Vm-pairs → hi) → 1:1.
    (instruction HADDPS (dst src) "haddps $dst, $src" (= dst (vhadd dst src 32)))
    (encoding HADDPS (Vps Wps) (repnz 0x0F 0x7C))
    (instruction HADDPD (dst src) "haddpd $dst, $src" (= dst (vhadd dst src 64)))
    (encoding HADDPD (Vpd Wpd) (opsize 0x0F 0x7C)))

(featuring ssse3
    (instruction PSHUFB-S (dst src) "pshufb $dst, $src" (= dst (vshufv dst src)))
    (encoding PSHUFB-S (Vdq Wdq) (opsize 0x0F 0x38 0x00))
    (instruction PALIGNR (dst src sel) "palignr $dst, $src, $sel" (= dst (valign dst src sel)))
    (encoding PALIGNR (Vdq Wdq Ib) (opsize 0x0F 0x3A 0x0F))
    (instruction PABSB (dst src) "pabsb $dst, $src" (= dst (viabs src 8)))
    (encoding PABSB (Vdq Wdq) (opsize 0x0F 0x38 0x1C))
    (instruction PABSW (dst src) "pabsw $dst, $src" (= dst (viabs src 16)))
    (encoding PABSW (Vdq Wdq) (opsize 0x0F 0x38 0x1D))
    (instruction PABSD (dst src) "pabsd $dst, $src" (= dst (viabs src 32)))
    (encoding PABSD (Vdq Wdq) (opsize 0x0F 0x38 0x1E)))

(featuring sse4.1
    (instruction PTEST (a b) "ptest $a, $b" (block
        (= ZF (== (& a b) 0))
        (= CF (== (& a (~ b)) 0))
        (= AF 0) (= OF 0) (= PF 0) (= SF 0)))
    (encoding PTEST (Vdq Wdq) (opsize 0x0F 0x38 0x17))
    (instruction PMOVZXBW (dst src) "pmovzxbw $dst, $src" (= dst (vzext src 8 16)))
    (encoding PMOVZXBW (Vdq Wq) (opsize 0x0F 0x38 0x30))
    (instruction PMOVZXWD (dst src) "pmovzxwd $dst, $src" (= dst (vzext src 16 32)))
    (encoding PMOVZXWD (Vdq Wq) (opsize 0x0F 0x38 0x33))
    ; THE SIBLING SWEEP I OWED WHEN I ADDED vzext (day-53's own law, at the arc that
    ; banked it): I wrote the head for BW/WD and never swept the family. vzext takes
    ; (sew dew) as PARAMETERS, so the four remaining members need NO new head -- the
    ; same call with different widths. Found by a hole-probe: for every absent opcode
    ; flanked by declared ones, decode a synthetic encoding at objdump ALONE and ask
    ; whether an independent decoder reads it as real. map-2 gave 34 of 222 holes real,
    ; map-3 gave 6 of 75 -- and 69-of-75 (bad) is what makes the 6 a finding rather
    ; than an artifact of a broad needle. Every operand shape below verified at
    ; objdump -M intel before transcription (own #67/#100).
    (instruction PMOVZXBD (dst src) "pmovzxbd $dst, $src" (= dst (vzext src 8 32)))
    (encoding PMOVZXBD (Vdq Wd) (opsize 0x0F 0x38 0x31))
    (instruction PMOVZXBQ (dst src) "pmovzxbq $dst, $src" (= dst (vzext src 8 64)))
    (encoding PMOVZXBQ (Vdq Ww) (opsize 0x0F 0x38 0x32))
    (instruction PMOVZXWQ (dst src) "pmovzxwq $dst, $src" (= dst (vzext src 16 64)))
    (encoding PMOVZXWQ (Vdq Wd) (opsize 0x0F 0x38 0x34))
    (instruction PMOVZXDQ (dst src) "pmovzxdq $dst, $src" (= dst (vzext src 32 64)))
    (encoding PMOVZXDQ (Vdq Wq) (opsize 0x0F 0x38 0x35))
    ; verified at bytes with objdump -M intel before adding:
    ;   66 0F 38 40 C1 = pmulld xmm0,xmm1   ·   66 0F 38 3D C1 = pmaxsd xmm0,xmm1
    (instruction PMULLD (dst src) "pmulld $dst, $src" (= dst (vibin dst src 32 2)))
    (encoding PMULLD (Vdq Wdq) (opsize 0x0F 0x38 0x40))
    (instruction PMAXSD (dst src) "pmaxsd $dst, $src" (= dst (vibin dst src 32 5)))
    (encoding PMAXSD (Vdq Wdq) (opsize 0x0F 0x38 0x3D))
    (instruction PMAXSB (dst src) "pmaxsb $dst, $src" (= dst (vibin dst src 8 5)))
    (encoding PMAXSB (Vdq Wdq) (opsize 0x0F 0x38 0x3C))
    (instruction PMINSD (dst src) "pminsd $dst, $src" (= dst (vibin dst src 32 6)))
    (encoding PMINSD (Vdq Wdq) (opsize 0x0F 0x38 0x39))
    (instruction PMINSB (dst src) "pminsb $dst, $src" (= dst (vibin dst src 8 6)))
    (encoding PMINSB (Vdq Wdq) (opsize 0x0F 0x38 0x38))
    (instruction PMAXUD (dst src) "pmaxud $dst, $src" (= dst (vibin dst src 32 7)))
    (encoding PMAXUD (Vdq Wdq) (opsize 0x0F 0x38 0x3F))
    (instruction PMAXUW (dst src) "pmaxuw $dst, $src" (= dst (vibin dst src 16 7)))
    (encoding PMAXUW (Vdq Wdq) (opsize 0x0F 0x38 0x3E))
    (instruction PMINUD (dst src) "pminud $dst, $src" (= dst (vibin dst src 32 8)))
    (encoding PMINUD (Vdq Wdq) (opsize 0x0F 0x38 0x3B))
    (instruction PMINUW (dst src) "pminuw $dst, $src" (= dst (vibin dst src 16 8)))
    (encoding PMINUW (Vdq Wdq) (opsize 0x0F 0x38 0x3A))
    (instruction PCMPEQQ (dst src) "pcmpeqq $dst, $src" (= dst (vibin dst src 64 3)))
    (encoding PCMPEQQ (Vdq Wdq) (opsize 0x0F 0x38 0x29))
    (instruction PEXTRB (dst src sel) "pextrb $dst, $src, $sel" (= dst (vlane-get src sel 8)))
    (encoding PEXTRB (Ed Vdq Ib) (opsize 0x0F 0x3A 0x14))
    (instruction PEXTRD (dst src sel) "pextrd $dst, $src, $sel" (= dst (vlane-get src sel 32)))
    (encoding PEXTRD (Ed Vdq Ib) (opsize 0x0F 0x3A 0x16))
    (instruction PINSRB (dst src sel) "pinsrb $dst, $src, $sel" (= dst (vlane-set dst src sel 8)))
    (encoding PINSRB (Vdq Ed Ib) (opsize 0x0F 0x3A 0x20))
    (instruction MOVNTDQA (dst src) "movntdqa $dst, $src" (intrinsic movntdqa dst src))
    (encoding MOVNTDQA (Vdq Mdq) (opsize 0x0F 0x38 0x2A))
    ; DPPS/DPPD: masked dot-product. imm[7:4]=src-lane-mask (which multiply),
    ; imm[3:0]=dst-lane-mask (where the sum lands; else 0). CP2077 wall #29
    ; @0x1401177bc: dpps xmm0,xmm4,0x7F = the vec3-normalize idiom (xyz·xyz →
    ; all 4 lanes → sqrtss = |v|). aarch64: fmul + INS-wzr per unmasked +
    ; faddp×2 → sum broadcast + INS-wzr per unmasked-out.
    (instruction DPPS (dst src imm) "dpps $dst, $src, $imm"
        (= dst (vdpp dst src imm 32)))
    (encoding DPPS (Vdq Wdq Ib) (opsize 0x0F 0x3A 0x40))
    (instruction DPPD (dst src imm) "dppd $dst, $src, $imm"
        (= dst (vdpp dst src imm 64)))
    (encoding DPPD (Vdq Wdq Ib) (opsize 0x0F 0x3A 0x41)))

(featuring sse4.2
    ; ⚠ AND THE ROW-COUNT ORDERING IS ORTHOGONAL TO SEVERITY, measured 2026-08-21.
    ; These three defs are 9,216 of the ~10,274 remaining track-fail rows -- the
    ; largest block by far -- and that number measures ENCODING DENSITY (imm8-space x
    ; reg-combos), not what real code uses. Scanned the 25MB corpus .text for the
    ; actual opcode bytes (66 0F 3A 60..63) with a live [pos] control (48 89 = 510,528
    ; hits): 15 raw byte-matches, which for a 4-byte pattern across 25MB is consistent
    ; with ZERO real uses. RCPPS-family: 91. RCPSS: 4. Same reading.
    ;
    ; ⟹ SO CLOSING THEM WOULD BUY SWEEP COMPLETENESS, NOT COVERAGE OF REAL BINARIES.
    ; The corpus lift arm is already 100.00% over 6.18M real insns. That is a
    ; different justification from the one a count-ordered worklist implies, and the
    ; distinction decides priority: an oracle-completeness item, not an Alky blocker.
    ;
    ; ‡ The byte-counts are UPPER bounds -- a short pattern appears inside longer
    ; instructions, in immediates and in data -- so they can only support "~none",
    ; never an exact figure. Stated because the number invites over-reading.
    ; ── PCMP*STR: the cost is PER-ARM, not "needs a primitive". ──────────────────
    ; I published these as "a string-compare state machine" and that framing is
    ; wrong for one arm and roughly right for the other, which is a real asymmetry
    ; rather than a deferral:
    ;
    ;   the imm8 selects 4 data formats x 4 aggregations x 4 polarities x 2 output
    ;   modes = 128 behaviours, plus (for the I-forms) an implicit-length scan that
    ;   finds each operand's length by looking for a null element.
    ;
    ;   C#   the encoding is (Vdq Wdq Ib) -- an Ib OPERAND BINDING, so the imm8 is
    ;        COMPILE-TIME (Binds -> OperandBind.Imm, the same mechanism vlane-get and
    ;        valign use). Each combination is then a FIXED unrolled decomposition and
    ;        only the imm8 values a real corpus actually uses need to exist. Not a
    ;        state machine at all.
    ;   Rust RustLiftGen emits ONE function per template and the imm differs per
    ;        decode, so it would need the full 128-way runtime select. That IS
    ;        expensive, and it is expensive for a structural reason rather than a
    ;        semantic one.
    ;
    ; So the honest statement is: lowerable on the C# arm at the cost of one
    ; decomposition per imm8 seen, and genuinely awkward on the Rust arm. 9,216 of
    ; the remaining track-fail rows are these FOUR defs (PCMPESTRM added 08-21), the
    ; largest single block left -- but the corpus enumerates ALL imm8 values, so
    ; closing them means all 128 behaviours on both arms, not just the used ones.
    ; Left intrinsic-bodied deliberately, with the cost named rather than the
    ; capability mis-stated.
    (instruction PCMPISTRI (a b pred) "pcmpistri $a, $b, $pred" (intrinsic pcmpistri a b pred))
    (encoding PCMPISTRI (Vdq Wdq Ib) (opsize 0x0F 0x3A 0x63))
    (instruction PCMPISTRM (a b pred) "pcmpistrm $a, $b, $pred" (intrinsic pcmpistrm a b pred))
    (encoding PCMPISTRM (Vdq Wdq Ib) (opsize 0x0F 0x3A 0x62))
    (instruction PCMPESTRI (a b pred) "pcmpestri $a, $b, $pred" (intrinsic pcmpestri a b pred))
    (encoding PCMPESTRI (Vdq Wdq Ib) (opsize 0x0F 0x3A 0x61))
    ; PCMPESTRM (0x60) -- the FOURTH family member, absent from every .isa until 2026-08-21
    ; while its three siblings were declared. Found by reading the family at objdump rather
    ; than by any instrument here: the sweep census only lists defs it HAS, and the XED
    ; census's blocker table is clipped to top-15 by blocked-insns, so ~7 live sites could
    ; never appear in it. A truncating report's absence reads identically to a real zero.
    ; DECODE-ONLY on purpose, and the JUSTIFICATION IS NARROWER THAN IT FIRST READ:
    ; I wrote "a refusal STOPS the linear sweep, ~570x an unexecutable row" here and the
    ; consumer REFUTED it at their own source -- their walk is `off++; undecodable++;
    ; continue;`, one byte, the loop continues, so a refusal costs the PER-FN STATS and
    ; never a call edge. Their A/B over 26 of these commits closed 657 undecodable bytes
    ; and call-edges held EXACT (990,299 -> 990,299). So the ~570x figure is retracted:
    ; what a declared row buys is the per-fn stats + the def-set census, which is what a
    ; trusted-tier read keys on -- real, and not 570x. Recorded rather than quietly
    ; dropped, because I propagated the bigger number into two artifacts and the bigger
    ; number flattered the work. /tmp/echidna carries 7 real sites, all `66 0f 3a 60 c1 0a`
    ; = pcmpestrm xmm0,xmm1,0xa in one SSE4.2 string routine at 21310311..21310422
    ; (+2 more that objdump reads as an opcode TABLE, i.e. data, not code).
    (instruction PCMPESTRM (a b pred) "pcmpestrm $a, $b, $pred" (intrinsic pcmpestrm a b pred))
    (encoding PCMPESTRM (Vdq Wdq Ib) (opsize 0x0F 0x3A 0x60))
    (instruction CRC32-B (dst src) "crc32 $dst, $src" (= dst (crc32 dst src 8)))
    (encoding CRC32-B (Gv Eb) (repnz 0x0F 0x38 0xF0))
    (instruction CRC32-V (dst src) "crc32 $dst, $src" (= dst (crc32 dst src 32)))
    (encoding CRC32-V (Gv Ev) (repnz 0x0F 0x38 0xF1)))
