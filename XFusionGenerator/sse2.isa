; sse2.isa — SSE2 tier. Gated behind (featuring sse2 ...) in xfusion.isa.
; The 66-prefixed pd rows + F2 sd rows on SSE1 opcodes, plus the integer-xmm
; family (66-prefixed MMX opcodes) that dominates real binaries (memcpy/strlen).

; --- pd/sd movement ---
(instruction MOVUPD (dst src) "movupd $dst, $src" (= dst src))
(encoding MOVUPD (Vpd Wpd) (opsize 0x0F 0x10))
(encoding MOVUPD (Wpd Vpd) (opsize 0x0F 0x11))

; MOVSD scalar-double: lane-0 move. SDM: reg←mem ZEROES upper; reg←reg MERGES
; upper (preserves dst[127:64]). ‡ v1: (= dst src) at width=64 → tier-0 does
; single str_x on state[xmm+i*2] = MERGE for both (reg←mem should zero). The
; divergence bites when a game relies on reg←mem clearing hi — flag when the
; recon surfaces a UCOMISD/etc reading garbage-hi. Follow-on: template splits
; on (is-mem src) → wrap in (zext ... 128) for mem-src.
(instruction MOVSD-X (dst src) "movsd $dst, $src" (= dst src))
(encoding MOVSD-X (Vsd Wsd) (repnz 0x0F 0x10))
(encoding MOVSD-X (Wsd Vsd) (repnz 0x0F 0x11))

(instruction MOVAPD (dst src) "movapd $dst, $src" (= dst src))
(encoding MOVAPD (Vpd Wpd) (opsize 0x0F 0x28))
(encoding MOVAPD (Wpd Vpd) (opsize 0x0F 0x29))

(instruction MOVMSKPD (dst src) "movmskpd $dst, $src" (= dst (vmovmsk src 64)))
(encoding MOVMSKPD (Gd Upd) (opsize 0x0F 0x50))

(instruction UNPCKLPD (dst src) "unpcklpd $dst, $src" (= dst (vzip dst src 64 #f)))
(encoding UNPCKLPD (Vpd Wpd) (opsize 0x0F 0x14))
(instruction UNPCKHPD (dst src) "unpckhpd $dst, $src" (= dst (vzip dst src 64 #t)))
(encoding UNPCKHPD (Vpd Wpd) (opsize 0x0F 0x15))

(instruction MOVLPD (dst src) "movlpd $dst, $src" (intrinsic movlpd dst src))
(encoding MOVLPD (Vq Mq) (opsize 0x0F 0x12))
(encoding MOVLPD (Mq Vq) (opsize 0x0F 0x13))
(instruction MOVHPD (dst src) "movhpd $dst, $src" (intrinsic movhpd dst src))
(encoding MOVHPD (Vq Mq) (opsize 0x0F 0x16))
(encoding MOVHPD (Mq Vq) (opsize 0x0F 0x17))

; --- pd/sd arithmetic ---
(instruction ADDPD (dst src) "addpd $dst, $src" (= dst (vfbin dst src 64 0)))
(encoding ADDPD (Vpd Wpd) (opsize 0x0F 0x58))
; Scalar-double arith: retype dst/src bits as f64, op, write back (write_operand
; Xmm@width=64 stores lane-0, upper preserved). = aarch64 fadd/fsub/fmul/fdiv d0,d1,d2.
(instruction ADDSD (dst src) "addsd $dst, $src" (= dst (+ (as-f64 dst) (as-f64 src))))
(encoding ADDSD (Vsd Wsd) (repnz 0x0F 0x58))

(instruction MULPD (dst src) "mulpd $dst, $src" (= dst (vfbin dst src 64 2)))
(encoding MULPD (Vpd Wpd) (opsize 0x0F 0x59))
(instruction MULSD (dst src) "mulsd $dst, $src" (= dst (* (as-f64 dst) (as-f64 src))))
(encoding MULSD (Vsd Wsd) (repnz 0x0F 0x59))

(instruction SUBPD (dst src) "subpd $dst, $src" (= dst (vfbin dst src 64 1)))
(encoding SUBPD (Vpd Wpd) (opsize 0x0F 0x5C))
(instruction SUBSD (dst src) "subsd $dst, $src" (= dst (- (as-f64 dst) (as-f64 src))))
(encoding SUBSD (Vsd Wsd) (repnz 0x0F 0x5C))

(instruction MINPD (dst src) "minpd $dst, $src" (= dst (vfmin dst src 64)))
(encoding MINPD (Vpd Wpd) (opsize 0x0F 0x5D))
(instruction MINSD (dst src) "minsd $dst, $src" (= dst (fmin (as-f64 dst) (as-f64 src))))
(encoding MINSD (Vsd Wsd) (repnz 0x0F 0x5D))

(instruction DIVPD (dst src) "divpd $dst, $src" (= dst (vfbin dst src 64 3)))
(encoding DIVPD (Vpd Wpd) (opsize 0x0F 0x5E))
(instruction DIVSD (dst src) "divsd $dst, $src" (= dst (/ (as-f64 dst) (as-f64 src))))
(encoding DIVSD (Vsd Wsd) (repnz 0x0F 0x5E))

(instruction MAXPD (dst src) "maxpd $dst, $src" (= dst (vfmax dst src 64)))
(encoding MAXPD (Vpd Wpd) (opsize 0x0F 0x5F))
(instruction MAXSD (dst src) "maxsd $dst, $src" (= dst (fmax (as-f64 dst) (as-f64 src))))
(encoding MAXSD (Vsd Wsd) (repnz 0x0F 0x5F))

(instruction SQRTPD (dst src) "sqrtpd $dst, $src" (= dst (vfun src 64 0)))
(encoding SQRTPD (Vpd Wpd) (opsize 0x0F 0x51))
(instruction SQRTSD (dst src) "sqrtsd $dst, $src" (= dst (fsqrt (as-f64 src))))
(encoding SQRTSD (Vsd Wsd) (repnz 0x0F 0x51))

; --- pd logicals ---
(instruction ANDPD (dst src) "andpd $dst, $src" (= dst (& dst src)))
(encoding ANDPD (Vpd Wpd) (opsize 0x0F 0x54))
(instruction ANDNPD (dst src) "andnpd $dst, $src" (= dst (& (~ dst) src)))
(encoding ANDNPD (Vpd Wpd) (opsize 0x0F 0x55))
(instruction ORPD (dst src) "orpd $dst, $src" (= dst (| dst src)))
(encoding ORPD (Vpd Wpd) (opsize 0x0F 0x56))
(instruction XORPD (dst src) "xorpd $dst, $src" (= dst (^ dst src)))
(encoding XORPD (Vpd Wpd) (opsize 0x0F 0x57))

; --- compares ---
(instruction UCOMISD (a b) "ucomisd $a, $b"
    (mlet (fa (as-f64 a) fb (as-f64 b) unord (| (fisnan fa) (fisnan fb)))
        (= PF unord)
        (= CF (| (flt fa fb) unord))
        (= ZF (| (feq fa fb) unord))
        (= OF 0) (= SF 0) (= AF 0)))
(encoding UCOMISD (Vsd Wsd) (opsize 0x0F 0x2E))
(instruction COMISD (a b) "comisd $a, $b"
    (mlet (fa (as-f64 a) fb (as-f64 b) unord (| (fisnan fa) (fisnan fb)))
        (= PF unord)
        (= CF (| (flt fa fb) unord))
        (= ZF (| (feq fa fb) unord))
        (= OF 0) (= SF 0) (= AF 0)))
(encoding COMISD (Vsd Wsd) (opsize 0x0F 0x2F))

(instruction CMPPD (dst src pred) "cmppd $dst, $src, $pred" (= dst (vfcmpp dst src pred 64)))
(encoding CMPPD (Vpd Wpd Ib) (opsize 0x0F 0xC2))
(instruction CMPSD-X (dst src pred) "cmpsd $dst, $src, $pred"
    (= dst (fcmpp (as-f64 dst) (as-f64 src) pred 64)))
(encoding CMPSD-X (Vsd Wsd Ib) (repnz 0x0F 0xC2))

; SHUFPD: dst[0]=dst[sel[0]], dst[1]=src[sel[1]]. vshuf @ew=64.
(instruction SHUFPD (dst src sel) "shufpd $dst, $src, $sel" (= dst (vshuf dst src sel 64)))
(encoding SHUFPD (Vpd Wpd Ib) (opsize 0x0F 0xC6))

; --- integer xmm: movement (the census bulk — memcpy/strlen inner loops) ---
; SSE mov-family: pure data movement. Alignment-fault on MOVDQA/APS is a
; hardware property (misaligned → #GP); the emulator's identity-map memory
; model doesn't distinguish, so both are a plain 128-bit move.
(instruction MOVDQA (dst src) "movdqa $dst, $src" (= dst src))
(encoding MOVDQA (Vdq Wdq) (opsize 0x0F 0x6F))
(encoding MOVDQA (Wdq Vdq) (opsize 0x0F 0x7F))

(instruction MOVDQU (dst src) "movdqu $dst, $src" (= dst src))
(encoding MOVDQU (Vdq Wdq) (rep 0x0F 0x6F))
(encoding MOVDQU (Wdq Vdq) (rep 0x0F 0x7F))

; MOVD/MOVQ gpr<->xmm (66 0F 6E/7E; REX.W makes it movq)
; MOVD/MOVQ gpr↔xmm: xmm-dest zeroes upper (SDM: "the destination operand's
; upper bits are cleared to all 0s"). op_w = 32 (movd) or 64 (movq via REX.W).
(instruction MOVD-X (dst src) "$(wname movd movd movq) $dst, $src"
    (= dst (zext (u64 src) 128)))
(encoding MOVD-X (Vdq Ev) (opsize 0x0F 0x6E))
(instruction MOVD-XS (dst src) "$(wname movd movd movq) $dst, $src"
    (= dst (u64 src)))
(encoding MOVD-XS (Ev Vdq) (opsize 0x0F 0x7E))

; MOVQ xmm<->xmm/m64 (F3 0F 7E load, 66 0F D6 store).
; SDM: "when the destination operand is an XMM register ... the high quadword
; is cleared to all 0s." dst=Vdq/Udq (width=128) so write_operand does a FULL
; write of the zext'd 128-bit value (upper=0). Was Vq/Wq (width=64) — since
; the scalar-preserve-upper fix, that would mask-INSERT low-64 → upper
; PRESERVED, wrong for MOVQ. Silicon-sweep phase-2b: 84 diffs, all silicon
; xmm.hi=0 vs interp xmm.hi=preserved — EXPOSED by the scalar-preserve fix
; (before it, everything zeroed, so MOVQ was accidentally correct).
; Src stays Wq (reads low-64 of xmm OR 64 bits from mem — both correct).
; Store form: xmm-dst arm = Udq (mod=11, full-128 write); mem-dst arm = Mq
; (mod≠11, 64-bit store). Disasm-gen mod-discriminates (MOVHLPS/MOVLPS @0F12
; is the precedent).
(instruction MOVQ-X (dst src) "movq $dst, $src"
    (= dst (zext (u64 src) 128)))
(encoding MOVQ-X (Vdq Wq) (rep 0x0F 0x7E))
(instruction MOVQ-XS (dst src) "movq $dst, $src"
    (= dst (zext (u64 src) 128)))
(encoding MOVQ-XS (Udq Vq) (opsize 0x0F 0xD6))
(instruction MOVQ-XM (dst src) "movq $dst, $src"
    (= dst (u64 src)))
(encoding MOVQ-XM (Mq Vq) (opsize 0x0F 0xD6))

; --- integer xmm: compare/extract ---
; PCMPEQ*/PCMPGT*: per-lane integer compare → all-1s/0 mask. cmpgt is SIGNED. vibin op=3/4.
(instruction PCMPEQB (dst src) "pcmpeqb $dst, $src" (= dst (vibin dst src 8 3)))
(encoding PCMPEQB (Vdq Wdq) (opsize 0x0F 0x74))
(instruction PCMPEQW (dst src) "pcmpeqw $dst, $src" (= dst (vibin dst src 16 3)))
(encoding PCMPEQW (Vdq Wdq) (opsize 0x0F 0x75))
(instruction PCMPEQD (dst src) "pcmpeqd $dst, $src" (= dst (vibin dst src 32 3)))
(encoding PCMPEQD (Vdq Wdq) (opsize 0x0F 0x76))

(instruction PCMPGTB (dst src) "pcmpgtb $dst, $src" (= dst (vibin dst src 8 4)))
(encoding PCMPGTB (Vdq Wdq) (opsize 0x0F 0x64))
(instruction PCMPGTW (dst src) "pcmpgtw $dst, $src" (= dst (vibin dst src 16 4)))
(encoding PCMPGTW (Vdq Wdq) (opsize 0x0F 0x65))
(instruction PCMPGTD (dst src) "pcmpgtd $dst, $src" (= dst (vibin dst src 32 4)))
(encoding PCMPGTD (Vdq Wdq) (opsize 0x0F 0x66))

; PMOVMSKB: dst = 16-bit mask, bit i = sign of src.b[i]. Upper GPR bits zeroed.
; (The pcmpeqb+pmovmskb pair = SSE2 strlen/memchr — the fallback path from
; dropping SSE4.2/PCMPISTRI in cpuid.)
(instruction PMOVMSKB (dst src) "pmovmskb $dst, $src" (= dst (vmovmsk src 8)))
(encoding PMOVMSKB (Gd Udq) (opsize 0x0F 0xD7))

; --- integer xmm: arithmetic/logic ---
; PADD*/PSUB*: per-lane wrapping integer add/sub. (vibin dst src ew op) op:0=add 1=sub 2=mul.
(instruction PADDB (dst src) "paddb $dst, $src" (= dst (vibin dst src 8 0)))
(encoding PADDB (Vdq Wdq) (opsize 0x0F 0xFC))
(instruction PADDW (dst src) "paddw $dst, $src" (= dst (vibin dst src 16 0)))
(encoding PADDW (Vdq Wdq) (opsize 0x0F 0xFD))
(instruction PADDD (dst src) "paddd $dst, $src" (= dst (vibin dst src 32 0)))
(encoding PADDD (Vdq Wdq) (opsize 0x0F 0xFE))
(instruction PADDQ (dst src) "paddq $dst, $src" (= dst (vibin dst src 64 0)))
(encoding PADDQ (Vdq Wdq) (opsize 0x0F 0xD4))

(instruction PSUBB (dst src) "psubb $dst, $src" (= dst (vibin dst src 8 1)))
(encoding PSUBB (Vdq Wdq) (opsize 0x0F 0xF8))
(instruction PSUBW (dst src) "psubw $dst, $src" (= dst (vibin dst src 16 1)))
(encoding PSUBW (Vdq Wdq) (opsize 0x0F 0xF9))
(instruction PSUBD (dst src) "psubd $dst, $src" (= dst (vibin dst src 32 1)))
(encoding PSUBD (Vdq Wdq) (opsize 0x0F 0xFA))
(instruction PSUBQ (dst src) "psubq $dst, $src" (= dst (vibin dst src 64 1)))
(encoding PSUBQ (Vdq Wdq) (opsize 0x0F 0xFB))

(instruction PAND (dst src) "pand $dst, $src" (= dst (& dst src)))
(encoding PAND (Vdq Wdq) (opsize 0x0F 0xDB))
(instruction PANDN (dst src) "pandn $dst, $src" (= dst (& (~ dst) src)))
(encoding PANDN (Vdq Wdq) (opsize 0x0F 0xDF))
(instruction POR (dst src) "por $dst, $src" (= dst (| dst src)))
(encoding POR (Vdq Wdq) (opsize 0x0F 0xEB))
(instruction PXOR (dst src) "pxor $dst, $src" (= dst (^ dst src)))
(encoding PXOR (Vdq Wdq) (opsize 0x0F 0xEF))

(instruction PMINUB (dst src) "pminub $dst, $src" (intrinsic pminub dst src))
(encoding PMINUB (Vdq Wdq) (opsize 0x0F 0xDA))
(instruction PMAXUB (dst src) "pmaxub $dst, $src" (intrinsic pmaxub dst src))
(encoding PMAXUB (Vdq Wdq) (opsize 0x0F 0xDE))

; --- integer xmm: shifts (imm forms are /N on 71/72/73) ---
; PSLL*/PSRL*/PSRA*-I: packed shift by IMMEDIATE. (vishi dst count-op ew dir) dir:0=shl 1=lshr 2=ashr.
; count>=ew → 0 (shl/lshr) or sign-fill (ashr) per SDM.
(instruction PSRLW-I (dst count) "psrlw $dst, $count" (= dst (vishi dst count 16 1)))
(encoding PSRLW-I (Udq Ib) (opsize 0x0F 0x71 /2))
(instruction PSRAW-I (dst count) "psraw $dst, $count" (= dst (vishi dst count 16 2)))
(encoding PSRAW-I (Udq Ib) (opsize 0x0F 0x71 /4))
(instruction PSLLW-I (dst count) "psllw $dst, $count" (= dst (vishi dst count 16 0)))
(encoding PSLLW-I (Udq Ib) (opsize 0x0F 0x71 /6))

(instruction PSRLD-I (dst count) "psrld $dst, $count" (= dst (vishi dst count 32 1)))
(encoding PSRLD-I (Udq Ib) (opsize 0x0F 0x72 /2))
(instruction PSRAD-I (dst count) "psrad $dst, $count" (= dst (vishi dst count 32 2)))
(encoding PSRAD-I (Udq Ib) (opsize 0x0F 0x72 /4))
(instruction PSLLD-I (dst count) "pslld $dst, $count" (= dst (vishi dst count 32 0)))
(encoding PSLLD-I (Udq Ib) (opsize 0x0F 0x72 /6))

(instruction PSRLQ-I (dst count) "psrlq $dst, $count" (= dst (vishi dst count 64 1)))
(encoding PSRLQ-I (Udq Ib) (opsize 0x0F 0x73 /2))
; PSRLDQ/PSLLDQ: byte-shift the whole 128-bit reg. count is BYTES (imm8);
; SDM: count>15 → dst=0. Semantically = u128 >> (count*8) bitcast back to V128.
(instruction PSRLDQ-I (dst count) "psrldq $dst, $count" (vshift-bytes dst count r))
(encoding PSRLDQ-I (Udq Ib) (opsize 0x0F 0x73 /3))
(instruction PSLLQ-I (dst count) "psllq $dst, $count" (= dst (vishi dst count 64 0)))
(encoding PSLLQ-I (Udq Ib) (opsize 0x0F 0x73 /6))
(instruction PSLLDQ-I (dst count) "pslldq $dst, $count" (vshift-bytes dst count l))
(encoding PSLLDQ-I (Udq Ib) (opsize 0x0F 0x73 /7))

; --- unpacks ---
; PUNPCKL*: interleave-low = aarch64 zip1 exactly. (vzip dst src W hi?) is a
; Builder-primitive; W = elem-bits (8/16/32/64), hi=#f=zip1=PUNPCKL, #t=zip2=PUNPCKH.
(instruction PUNPCKLBW (dst src) "punpcklbw $dst, $src" (= dst (vzip dst src 8 #f)))
(encoding PUNPCKLBW (Vdq Wdq) (opsize 0x0F 0x60))
(instruction PUNPCKLWD (dst src) "punpcklwd $dst, $src" (= dst (vzip dst src 16 #f)))
(encoding PUNPCKLWD (Vdq Wdq) (opsize 0x0F 0x61))
(instruction PUNPCKLDQ (dst src) "punpckldq $dst, $src" (= dst (vzip dst src 32 #f)))
(encoding PUNPCKLDQ (Vdq Wdq) (opsize 0x0F 0x62))
(instruction PUNPCKLQDQ (dst src) "punpcklqdq $dst, $src" (= dst (vzip dst src 64 #f)))
(encoding PUNPCKLQDQ (Vdq Wdq) (opsize 0x0F 0x6C))
(instruction PUNPCKHBW (dst src) "punpckhbw $dst, $src" (= dst (vzip dst src 8 #t)))
(encoding PUNPCKHBW (Vdq Wdq) (opsize 0x0F 0x68))
(instruction PUNPCKHWD (dst src) "punpckhwd $dst, $src" (= dst (vzip dst src 16 #t)))
(encoding PUNPCKHWD (Vdq Wdq) (opsize 0x0F 0x69))
(instruction PUNPCKHDQ (dst src) "punpckhdq $dst, $src" (= dst (vzip dst src 32 #t)))
(encoding PUNPCKHDQ (Vdq Wdq) (opsize 0x0F 0x6A))
(instruction PUNPCKHQDQ (dst src) "punpckhqdq $dst, $src" (= dst (vzip dst src 64 #t)))
(encoding PUNPCKHQDQ (Vdq Wdq) (opsize 0x0F 0x6D))

; --- shuffles ---
; PSHUFD: dst[i]=src[sel[2i+1:2i]] for all 4 lanes (all from src; not RMW).
; vshuf w/ a=b=src → low+high halves both source from src.
(instruction PSHUFD (dst src sel) "pshufd $dst, $src, $sel" (= dst (vshuf src src sel 32)))
(encoding PSHUFD (Vdq Wdq Ib) (opsize 0x0F 0x70))
; PSHUFLW: dst.w[0..3] = src.w[sel[2i+1:2i]], dst.w[4..7] = src.w[4..7] (copied). All from src.
(instruction PSHUFLW (dst src sel) "pshuflw $dst, $src, $sel" (= dst (vshufw src sel #f)))
(encoding PSHUFLW (Vdq Wdq Ib) (repnz 0x0F 0x70))
(instruction PSHUFHW (dst src sel) "pshufhw $dst, $src, $sel" (= dst (vshufw src sel #t)))
(encoding PSHUFHW (Vdq Wdq Ib) (rep 0x0F 0x70))

; --- converts ---
; Scalar float↔int conversions. src is Ev (op_w=32/64 signed int), dst is Vsd
; (xmm lane-0 double, upper preserved). (signed W src) reinterprets src as
; signed at op_w BEFORE the float-cast (SDM: source is a signed integer).
; ‡ CVTSI2SD's upper-preserve: write_operand Xmm at width=64 does str_x on
;   state[OFF_XMM+i*2] = lane-0 only, upper (word +1) untouched. ✓
(instruction CVTSI2SD (dst src) "cvtsi2sd $dst, $src"
    (= dst (f64 (signed (bitwidth src) src))))
(encoding CVTSI2SD (Vsd Ey) (repnz 0x0F 0x2A))
(instruction CVTSD2SI (dst src) "cvtsd2si $dst, $src"
    (= dst (int-of (bitwidth dst) (as-f64 src))))
(encoding CVTSD2SI (Gy Wsd) (repnz 0x0F 0x2D))
(instruction CVTTSD2SI (dst src) "cvttsd2si $dst, $src"
    (= dst (int-of (bitwidth dst) (as-f64 src))))
(encoding CVTTSD2SI (Gy Wsd) (repnz 0x0F 0x2C))

(instruction CVTSS2SD (dst src) "cvtss2sd $dst, $src"
    (= dst (f64 (as-f32 src))))
(encoding CVTSS2SD (Vsd Wss) (rep 0x0F 0x5A))
(instruction CVTSD2SS (dst src) "cvtsd2ss $dst, $src"
    (= dst (f32 (as-f64 src))))
(encoding CVTSD2SS (Vss Wsd) (repnz 0x0F 0x5A))
; CVTPS2PD: low 2× f32 → 2× f64.
(instruction CVTPS2PD (dst src) "cvtps2pd $dst, $src" (= dst (vcvt src 2)))
(encoding CVTPS2PD (Vpd Wps) (0x0F 0x5A))
; CVTPD2PS: 2× f64 → low 2× f32, upper 64 zeroed.
(instruction CVTPD2PS (dst src) "cvtpd2ps $dst, $src" (= dst (vcvt src 3)))
(encoding CVTPD2PS (Vps Wpd) (opsize 0x0F 0x5A))

; CVTDQ2PS: 4× i32 → 4× f32.
(instruction CVTDQ2PS (dst src) "cvtdq2ps $dst, $src" (= dst (vcvt src 0)))
(encoding CVTDQ2PS (Vps Wdq) (0x0F 0x5B))
; CVTPS2DQ: 4× f32→i32 round-per-MXCSR. ‡ hardcodes round-nearest (MXCSR default).
(instruction CVTPS2DQ (dst src) "cvtps2dq $dst, $src" (= dst (vcvt src 7)))
(encoding CVTPS2DQ (Vdq Wps) (opsize 0x0F 0x5B))
; CVTTPS2DQ: 4× f32 → 4× i32 truncate. ‡ overflow: x86→0x80000000, ARM saturates.
(instruction CVTTPS2DQ (dst src) "cvttps2dq $dst, $src" (= dst (vcvt src 1)))
(encoding CVTTPS2DQ (Vdq Wps) (rep 0x0F 0x5B))

; CVTDQ2PD: low 2× i32 → 2× f64.
(instruction CVTDQ2PD (dst src) "cvtdq2pd $dst, $src" (= dst (vcvt src 4)))
(encoding CVTDQ2PD (Vpd Wq) (rep 0x0F 0xE6))
; CVTPD2DQ: 2× f64→low 2× i32 round-per-MXCSR. ‡ hardcodes round-nearest.
(instruction CVTPD2DQ (dst src) "cvtpd2dq $dst, $src" (= dst (vcvt src 6)))
(encoding CVTPD2DQ (Vdq Wpd) (repnz 0x0F 0xE6))
; CVTTPD2DQ: 2× f64→low 2× i32 truncate, upper 64 zeroed.
(instruction CVTTPD2DQ (dst src) "cvttpd2dq $dst, $src" (= dst (vcvt src 5)))
(encoding CVTTPD2DQ (Vdq Wpd) (opsize 0x0F 0xE6))

; --- non-temporal + fences ---
; NT-stores: non-temporal is a cache hint (bypass L1); semantically a plain store.
(instruction MOVNTDQ (dst src) "movntdq $dst, $src" (= dst src))
(encoding MOVNTDQ (Mdq Vdq) (opsize 0x0F 0xE7))
(instruction MOVNTPD (dst src) "movntpd $dst, $src" (= dst src))
(encoding MOVNTPD (Mpd Vpd) (opsize 0x0F 0x2B))
(instruction MOVNTI (dst src) "movnti $dst, $src" (= dst src))
; MOVNTI is Md/Mq,Gd/Gq — y-width (32/64 by REX.W ONLY; no 16-bit form,
; 66 0F C3 = #UD on silicon). Caught by the mem-form sweep: 81 SIGILL
; rejects on the 66-prefixed rows the old Mv/Gv width-code emitted.
(encoding MOVNTI (My Gy) (0x0F 0xC3))

; Fences: memory-ordering barriers. Under mem_base=0 single-guest-thread,
; there's no reordering to fence — semantically a NOP. When SMP-guest
; arrives (multi-thread), these need real dmb sy/ld/st.
(instruction MFENCE () "mfence" (block))
(encoding MFENCE () (0x0F 0xAE /6))
(instruction LFENCE () "lfence" (block))
(encoding LFENCE () (0x0F 0xAE /5))

; Prefetch hints: pure cache-timing hints, ZERO architectural effect. NOPs.
(instruction PREFETCHT0 (src) "prefetcht0 $src" (block))
(encoding PREFETCHT0 (M) (0x0F 0x18 /1))
(instruction PREFETCHT1 (src) "prefetcht1 $src" (block))
(encoding PREFETCHT1 (M) (0x0F 0x18 /2))
(instruction PREFETCHT2 (src) "prefetcht2 $src" (block))
(encoding PREFETCHT2 (M) (0x0F 0x18 /3))
(instruction PREFETCHNTA (src) "prefetchnta $src" (block))
(encoding PREFETCHNTA (M) (0x0F 0x18 /0))
; PREFETCHW (0F 0D /1): prefetch-for-write (3DNow! → PRFCHW leaf7). Games
; emit it before atomic-RMW to reduce cache-line ping-pong. Also NOP.
; 0F 0D /0 = PREFETCH (AMD-only, obsolete); /2 = PREFETCHWT1 (deprecated).
(instruction PREFETCHW (src) "prefetchw $src" (block))
(encoding PREFETCHW (M) (0x0F 0x0D /1))
(instruction PREFETCH-A (src) "prefetch $src" (block))
(encoding PREFETCH-A (M) (0x0F 0x0D /0))
