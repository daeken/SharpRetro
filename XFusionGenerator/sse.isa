; sse.isa — SSE1 (Katmai) tier. Gated behind (featuring sse ...) in xfusion.isa.
; Same-opcode rows discriminate by mandatory prefix: bare=ps, F3=ss (F2/66 = sse2).
; Semantics at interpreter tier are intrinsics for now (packed-lane IL = a design
; conversation with the consumer before committing shape).

(instruction MOVUPS (dst src) "movups $dst, $src" (= dst src))
(encoding MOVUPS (Vps Wps) (0x0F 0x10))
(encoding MOVUPS (Wps Vps) (0x0F 0x11))

(instruction MOVSS (dst src) "movss $dst, $src" (= dst src))
(encoding MOVSS (Vss Wss) (rep 0x0F 0x10))
(encoding MOVSS (Wss Vss) (rep 0x0F 0x11))

(instruction MOVAPS (dst src) "movaps $dst, $src" (= dst src))
(encoding MOVAPS (Vps Wps) (0x0F 0x28))
(encoding MOVAPS (Wps Vps) (0x0F 0x29))

; MOVHLPS: dst[63:0]=src[127:64], dst[127:64] preserved. = vzip @ew=64 hi
; BUT with args SWAPPED: result = [src.hi, dst.hi], vzip(a,b,64,hi)=[a.hi,b.hi].
(instruction MOVHLPS (dst src) "movhlps $dst, $src" (= dst (vzip src dst 64 #t)))
(encoding MOVHLPS (Vps Ups) (0x0F 0x12))
(instruction MOVLPS (dst src) "movlps $dst, $src" (intrinsic movlps dst src))
(encoding MOVLPS (Vq Mq) (0x0F 0x12))
(encoding MOVLPS (Mq Vq) (0x0F 0x13))

; MOVLHPS: dst[127:64]=src[63:0], dst[63:0] preserved. = vzip @ew=64 lo
; (result lanes: [dst.lo, src.lo] = interleave-low of two 64-bit lanes).
(instruction MOVLHPS (dst src) "movlhps $dst, $src" (= dst (vzip dst src 64 #f)))
(encoding MOVLHPS (Vps Ups) (0x0F 0x16))
(instruction MOVHPS (dst src) "movhps $dst, $src" (intrinsic movhps dst src))
(encoding MOVHPS (Vq Mq) (0x0F 0x16))
(encoding MOVHPS (Mq Vq) (0x0F 0x17))

; MOVMSKPS: dst = 4-bit mask, bit i = sign of src.f32[i]. Upper GPR bits zeroed.
(instruction MOVMSKPS (dst src) "movmskps $dst, $src" (= dst (vmovmsk src 32)))
(encoding MOVMSKPS (Gd Ups) (0x0F 0x50))

; UNPCKLPS/HPS: bit-identical to PUNPCKLDQ/PUNPCKHDQ (32-bit lane interleave,
; float-typed but same op). vzip @ew=32.
(instruction UNPCKLPS (dst src) "unpcklps $dst, $src" (= dst (vzip dst src 32 #f)))
(encoding UNPCKLPS (Vps Wps) (0x0F 0x14))
(instruction UNPCKHPS (dst src) "unpckhps $dst, $src" (= dst (vzip dst src 32 #t)))
(encoding UNPCKHPS (Vps Wps) (0x0F 0x15))

; --- arithmetic: ps (bare) + ss (F3) rows share opcodes 58-5F ---
(instruction ADDPS (dst src) "addps $dst, $src" (= dst (vfbin dst src 32 0)))
(encoding ADDPS (Vps Wps) (0x0F 0x58))
(instruction ADDSS (dst src) "addss $dst, $src" (= dst (+ (as-f32 dst) (as-f32 src))))
(encoding ADDSS (Vss Wss) (rep 0x0F 0x58))

(instruction MULPS (dst src) "mulps $dst, $src" (= dst (vfbin dst src 32 2)))
(encoding MULPS (Vps Wps) (0x0F 0x59))
(instruction MULSS (dst src) "mulss $dst, $src" (= dst (* (as-f32 dst) (as-f32 src))))
(encoding MULSS (Vss Wss) (rep 0x0F 0x59))

(instruction SUBPS (dst src) "subps $dst, $src" (= dst (vfbin dst src 32 1)))
(encoding SUBPS (Vps Wps) (0x0F 0x5C))
(instruction SUBSS (dst src) "subss $dst, $src" (= dst (- (as-f32 dst) (as-f32 src))))
(encoding SUBSS (Vss Wss) (rep 0x0F 0x5C))

(instruction MINPS (dst src) "minps $dst, $src" (= dst (vfmin dst src 32)))
(encoding MINPS (Vps Wps) (0x0F 0x5D))
(instruction MINSS (dst src) "minss $dst, $src" (= dst (fmin (as-f32 dst) (as-f32 src))))
(encoding MINSS (Vss Wss) (rep 0x0F 0x5D))

(instruction DIVPS (dst src) "divps $dst, $src" (= dst (vfbin dst src 32 3)))
(encoding DIVPS (Vps Wps) (0x0F 0x5E))
(instruction DIVSS (dst src) "divss $dst, $src" (= dst (/ (as-f32 dst) (as-f32 src))))
(encoding DIVSS (Vss Wss) (rep 0x0F 0x5E))

; MAXPS: per-lane (dst>src)?dst:src, IEEE cmp → NaN/±0→src. x86-exact via FCMGT+BIT (NOT ARM FMAX).
(instruction MAXPS (dst src) "maxps $dst, $src" (= dst (vfmax dst src 32)))
(encoding MAXPS (Vps Wps) (0x0F 0x5F))
; MAXSS: dst = (dst>src)?dst:src, IEEE cmp → NaN/±0 return src. NOT ARM FMAX (which
; propagates NaN). tier-0 = FCMP+FCSEL cond=GT (unord→N≠V→GT false→src). x86-exact.
(instruction MAXSS (dst src) "maxss $dst, $src" (= dst (fmax (as-f32 dst) (as-f32 src))))
(encoding MAXSS (Vss Wss) (rep 0x0F 0x5F))

(instruction SQRTPS (dst src) "sqrtps $dst, $src" (= dst (vfun src 32 0)))
(encoding SQRTPS (Vps Wps) (0x0F 0x51))
; SQRTSS: dst[31:0] = sqrt(src[31:0]), dst[127:32] preserved. Same lane-0
; scalar-float pattern as ADDSS (as-f32 → op → write dst, which the Vss
; operand-write handles as lane-0 merge).
(instruction SQRTSS (dst src) "sqrtss $dst, $src" (= dst (fsqrt (as-f32 src))))
(encoding SQRTSS (Vss Wss) (rep 0x0F 0x51))

(instruction RSQRTPS (dst src) "rsqrtps $dst, $src" (intrinsic rsqrtps dst src))
(encoding RSQRTPS (Vps Wps) (0x0F 0x52))
(instruction RSQRTSS (dst src) "rsqrtss $dst, $src" (intrinsic rsqrtss dst src))
(encoding RSQRTSS (Vss Wss) (rep 0x0F 0x52))

(instruction RCPPS (dst src) "rcpps $dst, $src" (intrinsic rcpps dst src))
(encoding RCPPS (Vps Wps) (0x0F 0x53))
(instruction RCPSS (dst src) "rcpss $dst, $src" (intrinsic rcpss dst src))
(encoding RCPSS (Vss Wss) (rep 0x0F 0x53))

; --- logicals ---
(instruction ANDPS (dst src) "andps $dst, $src" (= dst (& dst src)))
(encoding ANDPS (Vps Wps) (0x0F 0x54))
(instruction ANDNPS (dst src) "andnps $dst, $src" (= dst (& (~ dst) src)))
(encoding ANDNPS (Vps Wps) (0x0F 0x55))
(instruction ORPS (dst src) "orps $dst, $src" (= dst (| dst src)))
(encoding ORPS (Vps Wps) (0x0F 0x56))
(instruction XORPS (dst src) "xorps $dst, $src" (= dst (^ dst src)))
(encoding XORPS (Vps Wps) (0x0F 0x57))

; --- compares ---
(instruction UCOMISS (a b) "ucomiss $a, $b"
    (mlet (fa (as-f32 a) fb (as-f32 b) unord (| (fisnan fa) (fisnan fb)))
        (= PF unord)
        (= CF (| (flt fa fb) unord))
        (= ZF (| (feq fa fb) unord))
        (= OF 0) (= SF 0) (= AF 0)))
(encoding UCOMISS (Vss Wss) (0x0F 0x2E))
; COMISS/UCOMISS: compare scalar single, set eflags:
;   unord (either NaN): ZF=PF=CF=1 | a>b: 0,0,0 | a<b: 0,0,1 | a==b: 1,0,0.
; OF/SF/AF cleared. UCOMISS = same flags (differs only on SNaN #IA — not modeled).
; PF = unordered; CF = a<b || unord; ZF = a==b || unord.
(instruction COMISS (a b) "comiss $a, $b"
    (mlet (fa (as-f32 a) fb (as-f32 b) unord (| (fisnan fa) (fisnan fb)))
        (= PF unord)
        (= CF (| (flt fa fb) unord))
        (= ZF (| (feq fa fb) unord))
        (= OF 0) (= SF 0) (= AF 0)))
(encoding COMISS (Vss Wss) (0x0F 0x2F))

; CMPPS: per-lane 8-predicate compare → per-lane all-1s/0 mask. Same table as CMPSS.
(instruction CMPPS (dst src pred) "cmpps $dst, $src, $pred" (= dst (vfcmpp dst src pred 32)))
(encoding CMPPS (Vps Wps Ib) (0x0F 0xC2))
; CMPSS: dst[31:0] = mask(pred(dst.f32, src.f32)), dst[127:32] preserved.
; pred = imm8[2:0] (0=EQ 1=LT 2=LE 3=UNORD 4=NEQ 5=NLT 6=NLE 7=ORD).
(instruction CMPSS (dst src pred) "cmpss $dst, $src, $pred"
    (= dst (fcmpp (as-f32 dst) (as-f32 src) pred 32)))
(encoding CMPSS (Vss Wss Ib) (rep 0x0F 0xC2))

; SHUFPS: dst[0,1] from dst[sel[1:0],sel[3:2]], dst[2,3] from src[sel[5:4],sel[7:6]].
; vshuf's a=low-half-source, b=high-half-source, so a=dst b=src.
(instruction SHUFPS (dst src sel) "shufps $dst, $src, $sel" (= dst (vshuf dst src sel 32)))
(encoding SHUFPS (Vps Wps Ib) (0x0F 0xC6))

; --- converts (SSE1 half: cvt*si2ss / ss2si / ps<->pi) ---
(instruction CVTSI2SS (dst src) "cvtsi2ss $dst, $src"
    (= dst (f32 (signed (bitwidth src) src))))
(encoding CVTSI2SS (Vss Ey) (rep 0x0F 0x2A))
(instruction CVTSS2SI (dst src) "cvtss2si $dst, $src"
    (= dst (int-of (bitwidth dst) (as-f32 src))))
; Ⓓ 6th .isa-tier: Gv→Gy (32/64 by REX.W only, 0x66 IGNORED). SDM's own
; Gy/Ey convention. Silicon-sweep phase-2: 66 F3 0F 2C C0 → silicon eax=
; (i32)f (66 ignored), interp was ax=(i16)f. 54 diffs across the 6 CVT rows.
(encoding CVTSS2SI (Gy Wss) (rep 0x0F 0x2D))
(instruction CVTTSS2SI (dst src) "cvttss2si $dst, $src"
    (= dst (int-of (bitwidth dst) (as-f32 src))))
(encoding CVTTSS2SI (Gy Wss) (rep 0x0F 0x2C))

; --- non-temporal + fences (SSE1) ---
(instruction MOVNTPS (dst src) "movntps $dst, $src" (= dst src))
(encoding MOVNTPS (Mps Vps) (0x0F 0x2B))

; STMXCSR/LDMXCSR — the JIT doesn't model MXCSR (‡ round-mode fixed at nearest,
; per the vcvt commit). STMXCSR stores the DEFAULT 0x1F80 (all masks set, RC=00,
; FTZ/DAZ=0 = a fresh-thread's MXCSR); LDMXCSR reads mem and discards (no-op).
; The typical game-engine pattern (verified at CP2077 0x140a24e14): stmxcsr;
; read; bts bit-15 (FTZ flush-to-zero, denormal-perf-hint); ldmxcsr — round-trip
; of the default with FTZ set. Not semantics-load-bearing. ‡ MXCSR state not
; carried — if a game later re-STMXCSR expecting its FTZ set, it reads default
; again; the ptrace-oracle would flag that on the re-read.
(instruction LDMXCSR (src) "ldmxcsr $src" (block))
(encoding LDMXCSR (Md) (0x0F 0xAE /2))
(instruction STMXCSR (dst) "stmxcsr $dst" (= dst 0x1F80))
(encoding STMXCSR (Md) (0x0F 0xAE /3))

(instruction SFENCE () "sfence" (fence))
(encoding SFENCE () (0x0F 0xAE /7))
