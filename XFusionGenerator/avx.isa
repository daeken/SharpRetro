; avx.isa — VEX-encoded tier. Gated behind (featuring avx ...) in xfusion.isa.
; VEX rows are separate encodings (vex-2src / vex-3src tokens) sharing semantics
; templates via new v-prefixed instructions. The C4/C5 prefix supplies map+pp+vvvv+L;
; dispatch folds pp into the same prefix fields legacy rows use (Decode.ApplyVexPp).
; Corpus-ranked (glibc x86-64 @0c819df): vmovdqu 1208, vpmovmskb 1061, vpcmpeqb
; 1017, vpaddb 460, vmovdqa 434, vzeroupper 422, vpandn 380 ...
;
; 2src = vvvv must be 0 (mov class); 3src = vvvv is second source (arith class).

; 0F 77: L=0 = vzeroupper, L=1 = vzeroall — one row, L-selected mnemonic.
(instruction VZEROUPPER () "$(lname vzeroupper vzeroall)" (intrinsic vzeroupper))
(encoding VZEROUPPER () (vex-2src 0x0F 0x77))

; --- moves (2src: vvvv==0) ---
(instruction VMOVDQU (dst src) "vmovdqu $dst, $src" (intrinsic vmovdqu dst src))
(encoding VMOVDQU (Vdq Wdq) (vex-2src rep 0x0F 0x6F))
(encoding VMOVDQU (Wdq Vdq) (vex-2src rep 0x0F 0x7F))

(instruction VMOVDQA (dst src) "vmovdqa $dst, $src" (intrinsic vmovdqa dst src))
(encoding VMOVDQA (Vdq Wdq) (vex-2src opsize 0x0F 0x6F))
(encoding VMOVDQA (Wdq Vdq) (vex-2src opsize 0x0F 0x7F))

(instruction VMOVUPS (dst src) "vmovups $dst, $src" (intrinsic vmovups dst src))
(encoding VMOVUPS (Vps Wps) (vex-2src 0x0F 0x10))
(encoding VMOVUPS (Wps Vps) (vex-2src 0x0F 0x11))

(instruction VMOVAPS (dst src) "vmovaps $dst, $src" (intrinsic vmovaps dst src))
(encoding VMOVAPS (Vps Wps) (vex-2src 0x0F 0x28))
(encoding VMOVAPS (Wps Vps) (vex-2src 0x0F 0x29))

(instruction VMOVNTDQ (dst src) "vmovntdq $dst, $src" (intrinsic vmovntdq dst src))
(encoding VMOVNTDQ (Mdq Vdq) (vex-2src opsize 0x0F 0xE7))

(instruction VPMOVMSKB (dst src) "vpmovmskb $dst, $src" (intrinsic vpmovmskb dst src))
(encoding VPMOVMSKB (Gd Udq) (vex-2src opsize 0x0F 0xD7))

; --- integer compare/arith (3src: vvvv = second source) ---
(instruction VPCMPEQB (dst a b) "vpcmpeqb $dst, $a, $b" (intrinsic vpcmpeqb dst a b))
(encoding VPCMPEQB (Vdq Hdq Wdq) (vex-3src opsize 0x0F 0x74))
(instruction VPCMPEQW (dst a b) "vpcmpeqw $dst, $a, $b" (intrinsic vpcmpeqw dst a b))
(encoding VPCMPEQW (Vdq Hdq Wdq) (vex-3src opsize 0x0F 0x75))
(instruction VPCMPEQD (dst a b) "vpcmpeqd $dst, $a, $b" (intrinsic vpcmpeqd dst a b))
(encoding VPCMPEQD (Vdq Hdq Wdq) (vex-3src opsize 0x0F 0x76))

(instruction VPCMPGTB (dst a b) "vpcmpgtb $dst, $a, $b" (intrinsic vpcmpgtb dst a b))
(encoding VPCMPGTB (Vdq Hdq Wdq) (vex-3src opsize 0x0F 0x64))

(instruction VPADDB (dst a b) "vpaddb $dst, $a, $b" (intrinsic vpaddb dst a b))
(encoding VPADDB (Vdq Hdq Wdq) (vex-3src opsize 0x0F 0xFC))
(instruction VPSUBB (dst a b) "vpsubb $dst, $a, $b" (intrinsic vpsubb dst a b))
(encoding VPSUBB (Vdq Hdq Wdq) (vex-3src opsize 0x0F 0xF8))

(instruction VPAND (dst a b) "vpand $dst, $a, $b" (intrinsic vpand dst a b))
(encoding VPAND (Vdq Hdq Wdq) (vex-3src opsize 0x0F 0xDB))
(instruction VPANDN (dst a b) "vpandn $dst, $a, $b" (intrinsic vpandn dst a b))
(encoding VPANDN (Vdq Hdq Wdq) (vex-3src opsize 0x0F 0xDF))
(instruction VPOR (dst a b) "vpor $dst, $a, $b" (intrinsic vpor dst a b))
(encoding VPOR (Vdq Hdq Wdq) (vex-3src opsize 0x0F 0xEB))
(instruction VPXOR (dst a b) "vpxor $dst, $a, $b" (intrinsic vpxor dst a b))
(encoding VPXOR (Vdq Hdq Wdq) (vex-3src opsize 0x0F 0xEF))

(instruction VPMINUB (dst a b) "vpminub $dst, $a, $b" (intrinsic vpminub dst a b))
(encoding VPMINUB (Vdq Hdq Wdq) (vex-3src opsize 0x0F 0xDA))
(instruction VPMAXUB (dst a b) "vpmaxub $dst, $a, $b" (intrinsic vpmaxub dst a b))
(encoding VPMAXUB (Vdq Hdq Wdq) (vex-3src opsize 0x0F 0xDE))

; --- shuffles: 2src + imm ---
(instruction VPSHUFD (dst src sel) "vpshufd $dst, $src, $sel" (intrinsic vpshufd dst src sel))
(encoding VPSHUFD (Vdq Wdq Ib) (vex-2src opsize 0x0F 0x70))

(instruction VPSHUFB (dst a b) "vpshufb $dst, $a, $b" (intrinsic vpshufb dst a b))
(encoding VPSHUFB (Vdq Hdq Wdq) (vex-3src opsize 0x0F 0x38 0x00))

; --- ptest (0F38 map, 2src) ---
(instruction VPTEST (a b) "vptest $a, $b" (intrinsic vptest a b))
(encoding VPTEST (Vdq Wdq) (vex-2src opsize 0x0F 0x38 0x17))

; --- vmovd/vmovq gpr<->xmm ---
(instruction VMOVD-V (dst src) "$(wname vmovd vmovd vmovq) $dst, $src" (intrinsic vmovd-v dst src))
(encoding VMOVD-V (Vdq Ev) (vex-2src opsize 0x0F 0x6E))
(instruction VMOVD-VS (dst src) "$(wname vmovd vmovd vmovq) $dst, $src" (intrinsic vmovd-vs dst src))
(encoding VMOVD-VS (Ev Vdq) (vex-2src opsize 0x0F 0x7E))
(instruction VMOVQ-V (dst src) "vmovq $dst, $src" (intrinsic vmovq-v dst src))
(encoding VMOVQ-V (Vq Wq) (vex-2src rep 0x0F 0x7E))

; --- BMI2 shifts (0F38 map, vvvv = shift-count source, VEX-only) ---
(instruction SARX (dst src count) "sarx $dst, $src, $count" (intrinsic sarx dst src count))
(encoding SARX (Gv Ev Hv) (vex-3src rep 0x0F 0x38 0xF7))
(instruction SHLX (dst src count) "shlx $dst, $src, $count" (intrinsic shlx dst src count))
(encoding SHLX (Gv Ev Hv) (vex-3src opsize 0x0F 0x38 0xF7))
(instruction SHRX (dst src count) "shrx $dst, $src, $count" (intrinsic shrx dst src count))
(encoding SHRX (Gv Ev Hv) (vex-3src repnz 0x0F 0x38 0xF7))
(instruction BZHI (dst src count) "bzhi $dst, $src, $count" (intrinsic bzhi dst src count))
(encoding BZHI (Gv Ev Hv) (vex-3src 0x0F 0x38 0xF5))

; --- VEX scalar-float: DECODE ONLY, and the reason is a real IL gap ---
;
; A full-scope capstone census over a 44MB shipped x86-64 binary names AVX as the
; decoder's largest remaining gap (1,114 on-stream instructions vs 16 off-stream =
; 70:1, so these are real code and not linear-sweep debris inside desync windows).
; The scalar third of that population -- vmulsd 62, vmovsd 55, vsubsd 42 -- is
; reachable through the same u64 carrier the SSE scalar cluster already uses, so it
; looked like the cheap half. It isn't, and the reason is worth writing down.
;
; SDM Vol 2A on VADDSD: DEST[63:0] := SRC1[63:0] + SRC2[63:0]
;                       DEST[127:64] := SRC1[127:64]
;                       DEST[MAXVL-1:128] := 0
; The upper lane comes from SRC1 -- the vvvv operand -- NOT from DEST. Our
; write_operand for an Xmm at width<128 preserves DEST's own upper (day-47 Ⓐ,
; silicon-verified against bare Intel: 1,350 of 1,600 diffs were this one fix).
; Those agree ONLY when dst == src1, which is the common two-operand-looking case
; and NOT the general one. So a `(= dst (+ (as-f64 src1) (as-f64 src2)))` body
; would be silently wrong whenever a compiler emits the three-register form -- the
; exact class the exec tier exists to catch, shipped as a body that type-checks.
;
; Expressing it faithfully needs a lane-insert primitive (write lane 0 of a v128
; while taking lane 1 from a third operand). IlLower has no vector node at all
; today: 7 IlVec* kinds exist in the shared IL, 0 are emitted, 0 evaluated.
; So these land `(intrinsic ...)` -- decode is what the corpus needs (a missing
; ENCODING desynchronises a linear sweep for the rest of the walk; a missing
; SEMANTICS is one instruction that dies loud at RunIntrinsic).
;
; Every encoding below was verified against `objdump -M intel` BEFORE it was
; written, not composed: C5 F3 59 C1 is `vmulsd xmm0,xmm1,xmm1`, C5 F2 10 C1 is
; `vmovss xmm0,xmm1,xmm1`. Hsd/Hss parse with no generator change -- OperandSpec
; maps 'H' with any non-"v" width to OpClass.XmmVvvv (:159).

(instruction VMOVSS (dst src1 src2) "vmovss $dst, $src1, $src2" (intrinsic vmovss dst src1 src2))
(encoding VMOVSS (Vss Hss Wss) (vex-3src rep 0x0F 0x10))
(instruction VADDSS (dst src1 src2) "vaddss $dst, $src1, $src2" (intrinsic vaddss dst src1 src2))
(encoding VADDSS (Vss Hss Wss) (vex-3src rep 0x0F 0x58))
(instruction VMULSS (dst src1 src2) "vmulss $dst, $src1, $src2" (intrinsic vmulss dst src1 src2))
(encoding VMULSS (Vss Hss Wss) (vex-3src rep 0x0F 0x59))
(instruction VSUBSS (dst src1 src2) "vsubss $dst, $src1, $src2" (intrinsic vsubss dst src1 src2))
(encoding VSUBSS (Vss Hss Wss) (vex-3src rep 0x0F 0x5C))
(instruction VDIVSS (dst src1 src2) "vdivss $dst, $src1, $src2" (intrinsic vdivss dst src1 src2))
(encoding VDIVSS (Vss Hss Wss) (vex-3src rep 0x0F 0x5E))

(instruction VMOVSD (dst src1 src2) "vmovsd $dst, $src1, $src2" (intrinsic vmovsd dst src1 src2))
(encoding VMOVSD (Vsd Hsd Wsd) (vex-3src repnz 0x0F 0x10))
(instruction VADDSD (dst src1 src2) "vaddsd $dst, $src1, $src2" (intrinsic vaddsd dst src1 src2))
(encoding VADDSD (Vsd Hsd Wsd) (vex-3src repnz 0x0F 0x58))
(instruction VMULSD (dst src1 src2) "vmulsd $dst, $src1, $src2" (intrinsic vmulsd dst src1 src2))
(encoding VMULSD (Vsd Hsd Wsd) (vex-3src repnz 0x0F 0x59))
(instruction VSUBSD (dst src1 src2) "vsubsd $dst, $src1, $src2" (intrinsic vsubsd dst src1 src2))
(encoding VSUBSD (Vsd Hsd Wsd) (vex-3src repnz 0x0F 0x5C))
(instruction VDIVSD (dst src1 src2) "vdivsd $dst, $src1, $src2" (intrinsic vdivsd dst src1 src2))
(encoding VDIVSD (Vsd Hsd Wsd) (vex-3src repnz 0x0F 0x5E))

; --- VEX packed-float: DECODE ONLY, same lane reason plus a WIDTH one ---
;
; The packed half of the AVX census (vmulps 84, vaddps 73, vshufps 66, vsubps 43 =
; 266 of the top-8's 472). Two reasons these can't carry semantics yet, and the
; second one is the harder:
;
; (1) THE LANE PROBLEM, as for the scalar rows above: SDM says the unused upper
;     lanes of a VEX 128-bit form are ZEROED (DEST[MAXVL-1:128] := 0), where the
;     legacy SSE form leaves them untouched. That is a difference our
;     write_operand cannot express -- it has one rule per width, not one per
;     encoding-family.
; (2) THE WIDTH PROBLEM, which is new here: VEX.L selects 128 or 256 bits at
;     DECODE time, so `vmulps` is two different operations behind one def. The
;     decoder already handles this (DecodedInsn.p.VexL, and v_width() returns
;     256 when set), and the C# disassembler renders ymm correctly -- verified:
;     C5 F1 EF C2 -> "vpxor xmm0, xmm1, xmm2" and C5 F5 EF C2 -> "vpxor ymm0,
;     ymm1, ymm2". But there is no 256-bit VALUE in either evaluator. X86Machine's
;     Xmm[] is u128 and Eval's carrier is ulong; a ymm operand has nowhere to live.
;
; So a body here would be wrong in two independent ways at once, and one of them
; (L=1) has no representable result at all. Intrinsic-bodied: the corpus gets its
; lengths, and the vector tier gets a clean slate when it lands.
;
; Every encoding objdump-verified BEFORE the edit, at BOTH lengths:
;   C5 F0 59 C1 = vmulps xmm0,xmm1,xmm1      C5 F4 59 C1 = vmulps ymm0,ymm1,ymm1
;   C5 F1 59 C1 = vmulpd xmm0,xmm1,xmm1      C5 F0 C6 C1 00 = vshufps xmm...,0x0
; Note pp=0 (no mprefix token) is the ps form -- first use of a prefix-less VEX row
; in this .isa; ParseOpcodes leaves mprefix null unless rep/repnz/opsize appears,
; so it parses with no generator change (XFusionDef.cs:165).

(instruction VADDPS (dst src1 src2) "vaddps $dst, $src1, $src2" (intrinsic vaddps dst src1 src2))
(encoding VADDPS (Vps Hps Wps) (vex-3src 0x0F 0x58))
(instruction VMULPS (dst src1 src2) "vmulps $dst, $src1, $src2" (intrinsic vmulps dst src1 src2))
(encoding VMULPS (Vps Hps Wps) (vex-3src 0x0F 0x59))
(instruction VSUBPS (dst src1 src2) "vsubps $dst, $src1, $src2" (intrinsic vsubps dst src1 src2))
(encoding VSUBPS (Vps Hps Wps) (vex-3src 0x0F 0x5C))
(instruction VDIVPS (dst src1 src2) "vdivps $dst, $src1, $src2" (intrinsic vdivps dst src1 src2))
(encoding VDIVPS (Vps Hps Wps) (vex-3src 0x0F 0x5E))

(instruction VADDPD (dst src1 src2) "vaddpd $dst, $src1, $src2" (intrinsic vaddpd dst src1 src2))
(encoding VADDPD (Vpd Hpd Wpd) (vex-3src opsize 0x0F 0x58))
(instruction VMULPD (dst src1 src2) "vmulpd $dst, $src1, $src2" (intrinsic vmulpd dst src1 src2))
(encoding VMULPD (Vpd Hpd Wpd) (vex-3src opsize 0x0F 0x59))
(instruction VSUBPD (dst src1 src2) "vsubpd $dst, $src1, $src2" (intrinsic vsubpd dst src1 src2))
(encoding VSUBPD (Vpd Hpd Wpd) (vex-3src opsize 0x0F 0x5C))
(instruction VDIVPD (dst src1 src2) "vdivpd $dst, $src1, $src2" (intrinsic vdivpd dst src1 src2))
(encoding VDIVPD (Vpd Hpd Wpd) (vex-3src opsize 0x0F 0x5E))

(instruction VSHUFPS (dst src1 src2 sel) "vshufps $dst, $src1, $src2, $sel" (intrinsic vshufps dst src1 src2 sel))
(encoding VSHUFPS (Vps Hps Wps Ib) (vex-3src 0x0F 0xC6))
(instruction VSHUFPD (dst src1 src2 sel) "vshufpd $dst, $src1, $src2, $sel" (intrinsic vshufpd dst src1 src2 sel))
(encoding VSHUFPD (Vpd Hpd Wpd Ib) (vex-3src opsize 0x0F 0xC6))
