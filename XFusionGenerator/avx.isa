(encoding VFMADDSUB231PS (Vps Hps Wps) (vex-3src opsize w0 0x0F 0x38 0xB6))
(instruction VFMADDSUB231PD (dst a b) "vfmaddsub231pd $dst, $a, $b" (= dst (vfma a b dst 64 4)))
(encoding VFMADDSUB231PD (Vpd Hpd Wpd) (vex-3src opsize w1 0x0F 0x38 0xB6))
(instruction VFMSUBADD132PS (dst a b) "vfmsubadd132ps $dst, $a, $b" (= dst (vfma dst b a 32 5)))
(encoding VFMSUBADD132PS (Vps Hps Wps) (vex-3src opsize w0 0x0F 0x38 0x97))
(instruction VFMSUBADD132PD (dst a b) "vfmsubadd132pd $dst, $a, $b" (= dst (vfma dst b a 64 5)))
(encoding VFMSUBADD132PD (Vpd Hpd Wpd) (vex-3src opsize w1 0x0F 0x38 0x97))
(instruction VFMSUBADD213PS (dst a b) "vfmsubadd213ps $dst, $a, $b" (= dst (vfma a dst b 32 5)))
(encoding VFMSUBADD213PS (Vps Hps Wps) (vex-3src opsize w0 0x0F 0x38 0xA7))
