(encoding BZHI (Gv Ev Hv) (vex-3src 0x0F 0x38 0xF5))

; --- FMA3 (66 0F38, W0 = single, W1 = double) ---
; 132: dst = dst*src3 + src2   213: dst = src2*dst + src3   231: dst = src2*src3 + dst
; (src2 = vvvv operand `a`, src3 = r/m operand `b`). One rounding: (vfma x y z ew mode)
; lowers each lane to the typed "fma" IL intrinsic. mode: 0 madd, 1 msub, 2 nmadd,
; 3 nmsub, 4 maddsub (even lanes subtract), 5 msubadd (even lanes add).
(instruction VFMADDSUB132PS (dst a b) "vfmaddsub132ps $dst, $a, $b" (= dst (vfma dst b a 32 4)))
(encoding VFMADDSUB132PS (Vps Hps Wps) (vex-3src opsize w0 0x0F 0x38 0x96))
(instruction VFMADDSUB132PD (dst a b) "vfmaddsub132pd $dst, $a, $b" (= dst (vfma dst b a 64 4)))
(encoding VFMADDSUB132PD (Vpd Hpd Wpd) (vex-3src opsize w1 0x0F 0x38 0x96))
(instruction VFMADDSUB213PS (dst a b) "vfmaddsub213ps $dst, $a, $b" (= dst (vfma a dst b 32 4)))
(encoding VFMADDSUB213PS (Vps Hps Wps) (vex-3src opsize w0 0x0F 0x38 0xA6))
(instruction VFMADDSUB213PD (dst a b) "vfmaddsub213pd $dst, $a, $b" (= dst (vfma a dst b 64 4)))
(encoding VFMADDSUB213PD (Vpd Hpd Wpd) (vex-3src opsize w1 0x0F 0x38 0xA6))
