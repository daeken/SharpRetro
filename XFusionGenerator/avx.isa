(instruction VFMSUBADD231PS (dst a b) "vfmsubadd231ps $dst, $a, $b" (= dst (vfma a b dst 32 5)))
(encoding VFMSUBADD231PS (Vps Hps Wps) (vex-3src opsize w0 0x0F 0x38 0xB7))
(instruction VFMSUBADD231PD (dst a b) "vfmsubadd231pd $dst, $a, $b" (= dst (vfma a b dst 64 5)))
(encoding VFMSUBADD231PD (Vpd Hpd Wpd) (vex-3src opsize w1 0x0F 0x38 0xB7))
(instruction VFMADD132PS (dst a b) "vfmadd132ps $dst, $a, $b" (= dst (vfma dst b a 32 0)))
(encoding VFMADD132PS (Vps Hps Wps) (vex-3src opsize w0 0x0F 0x38 0x98))
(instruction VFMADD132PD (dst a b) "vfmadd132pd $dst, $a, $b" (= dst (vfma dst b a 64 0)))
