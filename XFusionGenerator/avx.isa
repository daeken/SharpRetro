; avx.isa — VEX-encoded tier (AVX, AVX2, FMA, F16C). Gated behind (featuring avx ...).
; VEX rows are separate encodings (vex-2src / vex-3src) with v-prefixed templates.
; The C4/C5 prefix supplies map+pp+vvvv+L; dispatch folds pp into the same prefix
; fields legacy rows use (Decode.ApplyVexPp).
;
; Lowering contract (IlLower, VEX mode -- set by the lifter for every VEX/EVEX insn):
;   * Packed widths follow VEX.L: Vps/Wps/Hps/Vdq/Vx... bind at 128 or 256, and the
;     vector heads (vfbin, vibin, vzip, ...) take their width from the operands; heads
;     whose lanes interact (shuffles, interleaves, packs, hadd) apply per 128-bit block
;     at 256 bits, as the SDM defines the ymm forms.
;   * A VEX write of an xmm/ymm register zeroes everything above the value written, up
;     to MAXVL (taken as 256). So a 128-bit VEX op clears the upper ymm half, where the
;     legacy SSE row of the same op leaves it.
;   * Scalar VEX ops take their upper lanes from SRC1 (the vvvv operand), not from DEST:
;     DEST[127:w] := SRC1[127:w]. They write (vscalar src1 value), the full 128 bits.
;   * Width codes: o = 128 regardless of L (vextractf128's destination), h = half the
;     vector (64 at L=0, 128 at L=1: the source of a widening convert).
;
; 2src = vvvv must be 1111 (mov class); 3src = vvvv is a source operand.
; Encodings were checked against iced (the census's text diff) on the CP2077 corpus.

; --- state ---
; 0F 77: L=0 = vzeroupper (ymm0-15 bits 255:128 := 0), L=1 = vzeroall.
(instruction VZEROUPPER () "$(lname vzeroupper vzeroall)" (vzeroupper))
(encoding VZEROUPPER () (vex-2src 0x0F 0x77))

(instruction VLDMXCSR (src) "vldmxcsr $src" (block))
(encoding VLDMXCSR (Md) (vex-2src 0x0F 0xAE /2))
(instruction VSTMXCSR (dst) "vstmxcsr $dst" (= dst 0x1F80))
(encoding VSTMXCSR (Md) (vex-2src 0x0F 0xAE /3))

; --- full-vector moves ---
(instruction VMOVUPS (dst src) "vmovups $dst, $src" (= dst src))
(encoding VMOVUPS (Vps Wps) (vex-2src 0x0F 0x10))
(encoding VMOVUPS (Wps Vps) (vex-2src 0x0F 0x11))
(instruction VMOVUPD (dst src) "vmovupd $dst, $src" (= dst src))
(encoding VMOVUPD (Vpd Wpd) (vex-2src opsize 0x0F 0x10))
(encoding VMOVUPD (Wpd Vpd) (vex-2src opsize 0x0F 0x11))
(instruction VMOVAPS (dst src) "vmovaps $dst, $src" (= dst src))
(encoding VMOVAPS (Vps Wps) (vex-2src 0x0F 0x28))
(encoding VMOVAPS (Wps Vps) (vex-2src 0x0F 0x29))
(instruction VMOVAPD (dst src) "vmovapd $dst, $src" (= dst src))
(encoding VMOVAPD (Vpd Wpd) (vex-2src opsize 0x0F 0x28))
(encoding VMOVAPD (Wpd Vpd) (vex-2src opsize 0x0F 0x29))
(instruction VMOVDQU (dst src) "vmovdqu $dst, $src" (= dst src))
(encoding VMOVDQU (Vdq Wdq) (vex-2src rep 0x0F 0x6F))
(encoding VMOVDQU (Wdq Vdq) (vex-2src rep 0x0F 0x7F))
(instruction VMOVDQA (dst src) "vmovdqa $dst, $src" (= dst src))
(encoding VMOVDQA (Vdq Wdq) (vex-2src opsize 0x0F 0x6F))
(encoding VMOVDQA (Wdq Vdq) (vex-2src opsize 0x0F 0x7F))
(instruction VMOVNTDQ (dst src) "vmovntdq $dst, $src" (= dst src))
(encoding VMOVNTDQ (Mdq Vdq) (vex-2src opsize 0x0F 0xE7))
(instruction VMOVNTPS (dst src) "vmovntps $dst, $src" (= dst src))
(encoding VMOVNTPS (Mps Vps) (vex-2src 0x0F 0x2B))
(instruction VMOVNTPD (dst src) "vmovntpd $dst, $src" (= dst src))
(encoding VMOVNTPD (Mpd Vpd) (vex-2src opsize 0x0F 0x2B))

; --- scalar moves: reg,reg,reg merges from SRC1; the load zeroes bits 127:w; store w bits ---
(instruction VMOVSS (dst src1 src2) "vmovss $dst, $src1, $src2" (= dst (vscalar src1 src2)))
(encoding VMOVSS (Vss Hss Uss) (vex-3src rep 0x0F 0x10))
(encoding VMOVSS (Uss Hss Vss) (vex-3src rep 0x0F 0x11))
(instruction VMOVSS-LD (dst src) "vmovss $dst, $src" (= dst (zext src 128)))
(encoding VMOVSS-LD (Vss Md) (vex-2src rep 0x0F 0x10))
(instruction VMOVSS-ST (dst src) "vmovss $dst, $src" (= dst src))
(encoding VMOVSS-ST (Md Vss) (vex-2src rep 0x0F 0x11))
(instruction VMOVSD (dst src1 src2) "vmovsd $dst, $src1, $src2" (= dst (vscalar src1 src2)))
(encoding VMOVSD (Vsd Hsd Usd) (vex-3src repnz 0x0F 0x10))
(encoding VMOVSD (Usd Hsd Vsd) (vex-3src repnz 0x0F 0x11))
(instruction VMOVSD-LD (dst src) "vmovsd $dst, $src" (= dst (zext src 128)))
(encoding VMOVSD-LD (Vsd Mq) (vex-2src repnz 0x0F 0x10))
(instruction VMOVSD-ST (dst src) "vmovsd $dst, $src" (= dst src))
(encoding VMOVSD-ST (Mq Vsd) (vex-2src repnz 0x0F 0x11))

; --- vmovd/vmovq gpr<->xmm, vmovq xmm<->xmm/m64 ---
(instruction VMOVD-V (dst src) "$(wname vmovd vmovd vmovq) $dst, $src" (= dst (zext (u64 src) 128)))
(encoding VMOVD-V (Vdq Ev) (vex-2src opsize 0x0F 0x6E))
(instruction VMOVD-VS (dst src) "$(wname vmovd vmovd vmovq) $dst, $src" (= dst (u64 src)))
(encoding VMOVD-VS (Ev Vdq) (vex-2src opsize 0x0F 0x7E))
(instruction VMOVQ-V (dst src) "vmovq $dst, $src" (= dst (zext (u64 src) 128)))
(encoding VMOVQ-V (Vdq Wq) (vex-2src rep 0x0F 0x7E))
(instruction VMOVQ-XS (dst src) "vmovq $dst, $src" (= dst (zext (u64 src) 128)))
(encoding VMOVQ-XS (Udq Vq) (vex-2src opsize 0x0F 0xD6))
(instruction VMOVQ-XM (dst src) "vmovq $dst, $src" (= dst (u64 src)))
(encoding VMOVQ-XM (Mq Vq) (vex-2src opsize 0x0F 0xD6))

; --- broadcast / 128-bit halves / cross-lane permutes ---
(instruction VBROADCASTSS (dst src) "vbroadcastss $dst, $src" (= dst (vbcast dst src 32)))
(encoding VBROADCASTSS (Vx Md) (vex-2src opsize w0 0x0F 0x38 0x18))
(encoding VBROADCASTSS (Vx Uss) (vex-2src opsize w0 0x0F 0x38 0x18))
(instruction VBROADCASTSD (dst src) "vbroadcastsd $dst, $src" (= dst (vbcast dst src 64)))
(encoding VBROADCASTSD (Vx Mq) (vex-2src opsize w0 l1 0x0F 0x38 0x19))
(encoding VBROADCASTSD (Vx Usd) (vex-2src opsize w0 l1 0x0F 0x38 0x19))
(instruction VBROADCASTF128 (dst src) "vbroadcastf128 $dst, $src" (= dst (vbcast dst src 128)))
(encoding VBROADCASTF128 (Vx Mo) (vex-2src opsize w0 l1 0x0F 0x38 0x1A))
(instruction VEXTRACTF128 (dst src sel) "vextractf128 $dst, $src, $sel" (= dst (vhalf src sel)))
(encoding VEXTRACTF128 (Wo Vx Ib) (vex-2src opsize w0 l1 0x0F 0x3A 0x19))
(instruction VINSERTF128 (dst a b sel) "vinsertf128 $dst, $a, $b, $sel" (= dst (vinsert-half a b sel)))
(encoding VINSERTF128 (Vx Hx Wo Ib) (vex-3src opsize w0 l1 0x0F 0x3A 0x18))
; VPERMILPS/PD imm: shuffle within each 128-bit block (= PSHUFD's shape on one source).
(instruction VPERMILPS-I (dst src sel) "vpermilps $dst, $src, $sel" (= dst (vshuf src src sel 32)))
(encoding VPERMILPS-I (Vx Wx Ib) (vex-2src opsize w0 0x0F 0x3A 0x04))
(instruction VPERMILPD-I (dst src sel) "vpermilpd $dst, $src, $sel" (= dst (vshuf src src sel 64)))
(encoding VPERMILPD-I (Vx Wx Ib) (vex-2src opsize w0 0x0F 0x3A 0x05))
(instruction VPERMQ (dst src sel) "vpermq $dst, $src, $sel" (= dst (vperm64 src sel)))
(encoding VPERMQ (Vx Wx Ib) (vex-2src opsize w1 l1 0x0F 0x3A 0x00))
(instruction VPERMPD (dst src sel) "vpermpd $dst, $src, $sel" (= dst (vperm64 src sel)))
(encoding VPERMPD (Vx Wx Ib) (vex-2src opsize w1 l1 0x0F 0x3A 0x01))

; --- packed float arithmetic (3src) ---
(instruction VADDPS (dst a b) "vaddps $dst, $a, $b" (= dst (vfbin a b 32 0)))
(encoding VADDPS (Vps Hps Wps) (vex-3src 0x0F 0x58))
(instruction VADDPD (dst a b) "vaddpd $dst, $a, $b" (= dst (vfbin a b 64 0)))
(encoding VADDPD (Vpd Hpd Wpd) (vex-3src opsize 0x0F 0x58))
(instruction VSUBPS (dst a b) "vsubps $dst, $a, $b" (= dst (vfbin a b 32 1)))
(encoding VSUBPS (Vps Hps Wps) (vex-3src 0x0F 0x5C))
(instruction VSUBPD (dst a b) "vsubpd $dst, $a, $b" (= dst (vfbin a b 64 1)))
(encoding VSUBPD (Vpd Hpd Wpd) (vex-3src opsize 0x0F 0x5C))
(instruction VMULPS (dst a b) "vmulps $dst, $a, $b" (= dst (vfbin a b 32 2)))
(encoding VMULPS (Vps Hps Wps) (vex-3src 0x0F 0x59))
(instruction VMULPD (dst a b) "vmulpd $dst, $a, $b" (= dst (vfbin a b 64 2)))
(encoding VMULPD (Vpd Hpd Wpd) (vex-3src opsize 0x0F 0x59))
(instruction VDIVPS (dst a b) "vdivps $dst, $a, $b" (= dst (vfbin a b 32 3)))
(encoding VDIVPS (Vps Hps Wps) (vex-3src 0x0F 0x5E))
(instruction VDIVPD (dst a b) "vdivpd $dst, $a, $b" (= dst (vfbin a b 64 3)))
(encoding VDIVPD (Vpd Hpd Wpd) (vex-3src opsize 0x0F 0x5E))
(instruction VMINPS (dst a b) "vminps $dst, $a, $b" (= dst (vfmin a b 32)))
(encoding VMINPS (Vps Hps Wps) (vex-3src 0x0F 0x5D))
(instruction VMINPD (dst a b) "vminpd $dst, $a, $b" (= dst (vfmin a b 64)))
(encoding VMINPD (Vpd Hpd Wpd) (vex-3src opsize 0x0F 0x5D))
(instruction VMAXPS (dst a b) "vmaxps $dst, $a, $b" (= dst (vfmax a b 32)))
(encoding VMAXPS (Vps Hps Wps) (vex-3src 0x0F 0x5F))
(instruction VMAXPD (dst a b) "vmaxpd $dst, $a, $b" (= dst (vfmax a b 64)))
(encoding VMAXPD (Vpd Hpd Wpd) (vex-3src opsize 0x0F 0x5F))
(instruction VSQRTPS (dst src) "vsqrtps $dst, $src" (= dst (vfun src 32 0)))
(encoding VSQRTPS (Vps Wps) (vex-2src 0x0F 0x51))
(instruction VSQRTPD (dst src) "vsqrtpd $dst, $src" (= dst (vfun src 64 0)))
(encoding VSQRTPD (Vpd Wpd) (vex-2src opsize 0x0F 0x51))
; RCP/RSQRT approximations: intrinsic, as for the legacy rows (sse.isa: the exact value
; is architecturally permitted, but silicon returns a table-specific approximation).
(instruction VRCPPS (dst src) "vrcpps $dst, $src" (intrinsic vrcpps dst src))
(encoding VRCPPS (Vps Wps) (vex-2src 0x0F 0x53))
(instruction VRSQRTPS (dst src) "vrsqrtps $dst, $src" (intrinsic vrsqrtps dst src))
(encoding VRSQRTPS (Vps Wps) (vex-2src 0x0F 0x52))
(instruction VANDPS (dst a b) "vandps $dst, $a, $b" (= dst (& a b)))
(encoding VANDPS (Vps Hps Wps) (vex-3src 0x0F 0x54))
(instruction VANDPD (dst a b) "vandpd $dst, $a, $b" (= dst (& a b)))
(encoding VANDPD (Vpd Hpd Wpd) (vex-3src opsize 0x0F 0x54))
(instruction VANDNPS (dst a b) "vandnps $dst, $a, $b" (= dst (& (~ a) b)))
(encoding VANDNPS (Vps Hps Wps) (vex-3src 0x0F 0x55))
(instruction VANDNPD (dst a b) "vandnpd $dst, $a, $b" (= dst (& (~ a) b)))
(encoding VANDNPD (Vpd Hpd Wpd) (vex-3src opsize 0x0F 0x55))
(instruction VORPS (dst a b) "vorps $dst, $a, $b" (= dst (| a b)))
(encoding VORPS (Vps Hps Wps) (vex-3src 0x0F 0x56))
(instruction VORPD (dst a b) "vorpd $dst, $a, $b" (= dst (| a b)))
(encoding VORPD (Vpd Hpd Wpd) (vex-3src opsize 0x0F 0x56))
(instruction VXORPS (dst a b) "vxorps $dst, $a, $b" (= dst (^ a b)))
(encoding VXORPS (Vps Hps Wps) (vex-3src 0x0F 0x57))
(instruction VXORPD (dst a b) "vxorpd $dst, $a, $b" (= dst (^ a b)))
(encoding VXORPD (Vpd Hpd Wpd) (vex-3src opsize 0x0F 0x57))
(instruction VADDSUBPS (dst a b) "vaddsubps $dst, $a, $b" (= dst (vaddsub a b 32)))
(encoding VADDSUBPS (Vps Hps Wps) (vex-3src repnz 0x0F 0xD0))
(instruction VADDSUBPD (dst a b) "vaddsubpd $dst, $a, $b" (= dst (vaddsub a b 64)))
(encoding VADDSUBPD (Vpd Hpd Wpd) (vex-3src opsize 0x0F 0xD0))
(instruction VHADDPS (dst a b) "vhaddps $dst, $a, $b" (= dst (vhadd a b 32)))
(encoding VHADDPS (Vps Hps Wps) (vex-3src repnz 0x0F 0x7C))
(instruction VHADDPD (dst a b) "vhaddpd $dst, $a, $b" (= dst (vhadd a b 64)))
(encoding VHADDPD (Vpd Hpd Wpd) (vex-3src opsize 0x0F 0x7C))
(instruction VHSUBPS (dst a b) "vhsubps $dst, $a, $b" (= dst (vhsub a b 32)))
(encoding VHSUBPS (Vps Hps Wps) (vex-3src repnz 0x0F 0x7D))
(instruction VHSUBPD (dst a b) "vhsubpd $dst, $a, $b" (= dst (vhsub a b 64)))
(encoding VHSUBPD (Vpd Hpd Wpd) (vex-3src opsize 0x0F 0x7D))
(instruction VSHUFPS (dst a b sel) "vshufps $dst, $a, $b, $sel" (= dst (vshuf a b sel 32)))
(encoding VSHUFPS (Vps Hps Wps Ib) (vex-3src 0x0F 0xC6))
(instruction VSHUFPD (dst a b sel) "vshufpd $dst, $a, $b, $sel" (= dst (vshuf a b sel 64)))
(encoding VSHUFPD (Vpd Hpd Wpd Ib) (vex-3src opsize 0x0F 0xC6))
(instruction VUNPCKLPS (dst a b) "vunpcklps $dst, $a, $b" (= dst (vzip a b 32 #f)))
(encoding VUNPCKLPS (Vps Hps Wps) (vex-3src 0x0F 0x14))
(instruction VUNPCKHPS (dst a b) "vunpckhps $dst, $a, $b" (= dst (vzip a b 32 #t)))
(encoding VUNPCKHPS (Vps Hps Wps) (vex-3src 0x0F 0x15))
(instruction VUNPCKLPD (dst a b) "vunpcklpd $dst, $a, $b" (= dst (vzip a b 64 #f)))
(encoding VUNPCKLPD (Vpd Hpd Wpd) (vex-3src opsize 0x0F 0x14))
(instruction VUNPCKHPD (dst a b) "vunpckhpd $dst, $a, $b" (= dst (vzip a b 64 #t)))
(encoding VUNPCKHPD (Vpd Hpd Wpd) (vex-3src opsize 0x0F 0x15))
(instruction VCMPPS (dst a b pred) "vcmpps $dst, $a, $b, $pred" (= dst (vfcmpp a b pred 32)))
(encoding VCMPPS (Vps Hps Wps Ib) (vex-3src 0x0F 0xC2))
(instruction VCMPPD (dst a b pred) "vcmppd $dst, $a, $b, $pred" (= dst (vfcmpp a b pred 64)))
(encoding VCMPPD (Vpd Hpd Wpd Ib) (vex-3src opsize 0x0F 0xC2))
(instruction VBLENDPS (dst a b sel) "vblendps $dst, $a, $b, $sel" (= dst (vblend a b sel 32)))
(encoding VBLENDPS (Vps Hps Wps Ib) (vex-3src opsize 0x0F 0x3A 0x0C))
(instruction VBLENDPD (dst a b sel) "vblendpd $dst, $a, $b, $sel" (= dst (vblend a b sel 64)))
(encoding VBLENDPD (Vpd Hpd Wpd Ib) (vex-3src opsize 0x0F 0x3A 0x0D))
(instruction VROUNDPS (dst src sel) "vroundps $dst, $src, $sel" (= dst (vround src sel 32)))
(encoding VROUNDPS (Vps Wps Ib) (vex-2src opsize 0x0F 0x3A 0x08))
(instruction VROUNDPD (dst src sel) "vroundpd $dst, $src, $sel" (= dst (vround src sel 64)))
(encoding VROUNDPD (Vpd Wpd Ib) (vex-2src opsize 0x0F 0x3A 0x09))
(instruction VMOVMSKPS (dst src) "vmovmskps $dst, $src" (= dst (vmovmsk src 32)))
(encoding VMOVMSKPS (Gd Ups) (vex-2src 0x0F 0x50))
(instruction VMOVMSKPD (dst src) "vmovmskpd $dst, $src" (= dst (vmovmsk src 64)))
(encoding VMOVMSKPD (Gd Upd) (vex-2src opsize 0x0F 0x50))

; --- scalar float (3src): DEST[w-1:0] := op, DEST[127:w] := SRC1[127:w] ---
(instruction VADDSS (dst a b) "vaddss $dst, $a, $b" (= dst (vscalar a (+ (as-f32 a) (as-f32 b)))))
(encoding VADDSS (Vss Hss Wss) (vex-3src rep 0x0F 0x58))
(instruction VADDSD (dst a b) "vaddsd $dst, $a, $b" (= dst (vscalar a (+ (as-f64 a) (as-f64 b)))))
(encoding VADDSD (Vsd Hsd Wsd) (vex-3src repnz 0x0F 0x58))
(instruction VSUBSS (dst a b) "vsubss $dst, $a, $b" (= dst (vscalar a (- (as-f32 a) (as-f32 b)))))
(encoding VSUBSS (Vss Hss Wss) (vex-3src rep 0x0F 0x5C))
(instruction VSUBSD (dst a b) "vsubsd $dst, $a, $b" (= dst (vscalar a (- (as-f64 a) (as-f64 b)))))
(encoding VSUBSD (Vsd Hsd Wsd) (vex-3src repnz 0x0F 0x5C))
(instruction VMULSS (dst a b) "vmulss $dst, $a, $b" (= dst (vscalar a (* (as-f32 a) (as-f32 b)))))
(encoding VMULSS (Vss Hss Wss) (vex-3src rep 0x0F 0x59))
(instruction VMULSD (dst a b) "vmulsd $dst, $a, $b" (= dst (vscalar a (* (as-f64 a) (as-f64 b)))))
(encoding VMULSD (Vsd Hsd Wsd) (vex-3src repnz 0x0F 0x59))
(instruction VDIVSS (dst a b) "vdivss $dst, $a, $b" (= dst (vscalar a (/ (as-f32 a) (as-f32 b)))))
(encoding VDIVSS (Vss Hss Wss) (vex-3src rep 0x0F 0x5E))
(instruction VDIVSD (dst a b) "vdivsd $dst, $a, $b" (= dst (vscalar a (/ (as-f64 a) (as-f64 b)))))
(encoding VDIVSD (Vsd Hsd Wsd) (vex-3src repnz 0x0F 0x5E))
(instruction VMINSS (dst a b) "vminss $dst, $a, $b" (= dst (vscalar a (fmin (as-f32 a) (as-f32 b)))))
(encoding VMINSS (Vss Hss Wss) (vex-3src rep 0x0F 0x5D))
(instruction VMINSD (dst a b) "vminsd $dst, $a, $b" (= dst (vscalar a (fmin (as-f64 a) (as-f64 b)))))
(encoding VMINSD (Vsd Hsd Wsd) (vex-3src repnz 0x0F 0x5D))
(instruction VMAXSS (dst a b) "vmaxss $dst, $a, $b" (= dst (vscalar a (fmax (as-f32 a) (as-f32 b)))))
(encoding VMAXSS (Vss Hss Wss) (vex-3src rep 0x0F 0x5F))
(instruction VMAXSD (dst a b) "vmaxsd $dst, $a, $b" (= dst (vscalar a (fmax (as-f64 a) (as-f64 b)))))
(encoding VMAXSD (Vsd Hsd Wsd) (vex-3src repnz 0x0F 0x5F))
(instruction VSQRTSS (dst a b) "vsqrtss $dst, $a, $b" (= dst (vscalar a (fsqrt (as-f32 b)))))
(encoding VSQRTSS (Vss Hss Wss) (vex-3src rep 0x0F 0x51))
(instruction VSQRTSD (dst a b) "vsqrtsd $dst, $a, $b" (= dst (vscalar a (fsqrt (as-f64 b)))))
(encoding VSQRTSD (Vsd Hsd Wsd) (vex-3src repnz 0x0F 0x51))
(instruction VCMPSS (dst a b pred) "vcmpss $dst, $a, $b, $pred" (= dst (vscalar a (fcmpp (as-f32 a) (as-f32 b) pred 32))))
(encoding VCMPSS (Vss Hss Wss Ib) (vex-3src rep 0x0F 0xC2))
(instruction VCMPSD (dst a b pred) "vcmpsd $dst, $a, $b, $pred" (= dst (vscalar a (fcmpp (as-f64 a) (as-f64 b) pred 64))))
(encoding VCMPSD (Vsd Hsd Wsd Ib) (vex-3src repnz 0x0F 0xC2))
(instruction VROUNDSS (dst a b sel) "vroundss $dst, $a, $b, $sel" (= dst (vscalar a (fround-imm (as-f32 b) sel))))
(encoding VROUNDSS (Vss Hss Wss Ib) (vex-3src opsize 0x0F 0x3A 0x0A))
(instruction VROUNDSD (dst a b sel) "vroundsd $dst, $a, $b, $sel" (= dst (vscalar a (fround-imm (as-f64 b) sel))))
(encoding VROUNDSD (Vsd Hsd Wsd Ib) (vex-3src opsize 0x0F 0x3A 0x0B))
(instruction VUCOMISS (a b) "vucomiss $a, $b"
    (mlet (fa (as-f32 a) fb (as-f32 b) unord (| (fisnan fa) (fisnan fb)))
        (= PF unord)
        (= CF (| (flt fa fb) unord))
        (= ZF (| (feq fa fb) unord))
        (= OF 0) (= SF 0) (= AF 0)))
(encoding VUCOMISS (Vss Wss) (vex-2src 0x0F 0x2E))
(instruction VCOMISS (a b) "vcomiss $a, $b"
    (mlet (fa (as-f32 a) fb (as-f32 b) unord (| (fisnan fa) (fisnan fb)))
        (= PF unord)
        (= CF (| (flt fa fb) unord))
        (= ZF (| (feq fa fb) unord))
        (= OF 0) (= SF 0) (= AF 0)))
(encoding VCOMISS (Vss Wss) (vex-2src 0x0F 0x2F))
(instruction VUCOMISD (a b) "vucomisd $a, $b"
    (mlet (fa (as-f64 a) fb (as-f64 b) unord (| (fisnan fa) (fisnan fb)))
        (= PF unord)
        (= CF (| (flt fa fb) unord))
        (= ZF (| (feq fa fb) unord))
        (= OF 0) (= SF 0) (= AF 0)))
(encoding VUCOMISD (Vsd Wsd) (vex-2src opsize 0x0F 0x2E))
(instruction VCOMISD (a b) "vcomisd $a, $b"
    (mlet (fa (as-f64 a) fb (as-f64 b) unord (| (fisnan fa) (fisnan fb)))
        (= PF unord)
        (= CF (| (flt fa fb) unord))
        (= ZF (| (feq fa fb) unord))
        (= OF 0) (= SF 0) (= AF 0)))
(encoding VCOMISD (Vsd Wsd) (vex-2src opsize 0x0F 0x2F))

; --- converts ---
(instruction VCVTDQ2PS (dst src) "vcvtdq2ps $dst, $src" (= dst (vcvt src 0)))
(encoding VCVTDQ2PS (Vps Wdq) (vex-2src 0x0F 0x5B))
