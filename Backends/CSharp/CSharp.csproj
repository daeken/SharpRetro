<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>Backends.CSharp</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- CS8321 (unused local function): the extraction preserves Define()-locals verbatim;
         some (e.g. SignExt in Logic) are only referenced by the exec-half, which lives in
         ArchCompilerCore now. Harmless dead locals; suppressing the warning keeps the
         extraction mechanical rather than filtering per-local. -->
    <NoWarn>$(NoWarn);CS8321</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../ArchCompilerCore/ArchCompilerCore.csproj" />
    <ProjectReference Include="../../Aarch64Common/Aarch64Common.csproj" />
    <ProjectReference Include="../../Frontends/Aarch64/Aarch64.csproj" />
    <ProjectReference Include="../../Frontends/Dmg/Dmg.csproj" />
    <ProjectReference Include="../../Frontends/Mips/Mips.csproj" />
  </ItemGroup>
</Project>
